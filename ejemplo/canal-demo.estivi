format = 2
name = "Canal de prueba"
freq_hz = 14230000
interval_min = 10

[station]
call = "N0CALL"
operator = "Operador"
qth = "Córdoba"
locator = "FF78"

[tx]
mode = "M1"
color_range = "full"
vox_preamble = false
cw_preamble = true
cw_id = true
cw_text = "DE {call}"
cw_wpm = 20.0
cw_tone_hz = 800.0
min_pause_s = 60

[ax25]
info = true
mode = true
by_count = true
next_count = 8
next_hours = 6
dedupe = true

[[programs]]
id = 1
name = "Ajuste y paisaje"
enabled = true
weekdays = [true, true, true, true, true, false, false]
start = "12:00"
end = "15:00"
hue = 200

[programs.welcome]
path = "programas/carta-de-ajuste.png"
mode = "R36"

[[programs]]
id = 2
name = "Cierre"
enabled = true
weekdays = [false, false, false, false, false, true, false]
start = "23:45"
end = "23:55"
hue = 28

[programs.bye]
path = "programas/73.png"
mode = "R24"

[[blocks]]
id = 3
date = "2026-10-27"
name = "Noche en 80 m"
start = "21:00"
end = "23:30"
enabled = true

[[activations]]
id = 10
enabled = true
name = "Pausa"
[[activations.triggers]]
source = "dtmf"
code = "*0#"
[[activations.actions]]
kind = "pause"

[[activations]]
id = 11
enabled = true
name = "Carta"
[[activations.triggers]]
source = "dtmf"
code = "*1#"
[[activations.actions]]
kind = "image"
path = "programas/carta-de-ajuste.png"
mode = "M1"

[grid]
timezone = "utc"

[graphics]
background = "#000000"
fit = "cover"

[[graphics.layers]]
id = 1
name = "Zócalo"
visible = true
x = 0.0
y = 0.82
w = 1.0
h = 0.18
opacity = 1.0
tipo = "text"
text = "{call} · {qth}"
font = "Noto Sans"
bold = true
size = 0.11
color = "#FFFFFF"
align = "start"
valign = "center"
shrink_to_fit = true
outline = 0.0
outline_color = "#000000"
shadow = false
box_color = "#0B1F3AD0"

[[graphics.layers]]
id = 2
name = "Hora y número"
visible = true
x = 0.03
y = 0.03
w = 0.5
h = 0.1
opacity = 1.0
tipo = "text"
text = "{utc}Z  #{serial:3}  {block}"
font = "Noto Sans Mono"
bold = true
size = 0.075
color = "#FFE066"
align = "start"
valign = "center"
shrink_to_fit = true
outline = 0.14
outline_color = "#000000"
shadow = true
box_color = "#00000000"

[[graphics.layers]]
id = 3
name = "Logo"
visible = true
x = 0.79
y = 0.03
w = 0.18
h = 0.225
opacity = 1.0
tipo = "image"
path = "logo.png"
keep_aspect = true

[[graphics.layers]]
id = 4
name = "Clima (API, ejemplo)"
visible = false
x = 0.55
y = 0.68
w = 0.42
h = 0.12
opacity = 1.0
tipo = "text"
text = "{qth} {api} °C"
font = "Noto Sans"
bold = true
size = 0.07
color = "#FFFFFF"
align = "end"
valign = "center"
shrink_to_fit = true
outline = 0.12
outline_color = "#000000"
shadow = false
box_color = "#00000000"

[graphics.layers.api]
url = "https://api.open-meteo.com/v1/forecast?latitude=-31.42&longitude=-64.18&current=temperature_2m"
json_path = "current.temperature_2m"
refresh_s = 600

[[graphics.layers]]
id = 5
name = "QR"
visible = true
x = 0.03
y = 0.55
w = 0.22
h = 0.28
opacity = 1.0
tipo = "qr"
ecc = "M"
source = "text"
text = "{call} {freq}"

[listen]
cw = false
cw_wpm = 20.0
cw_tone_hz = 700.0
dtmf = true
