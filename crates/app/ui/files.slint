import { LineEdit, Palette } from "std-widgets.slint";
import { Theme, ToolButton, Field, Icon } from "theme.slint";

// Opaque in Slint: the host reads file paths from the OS drop.
export global Files {
    // Set from Rust when the OS reports a file hovering the window (winit XDND).
    in-out property <bool> hovering;
    callback has-files(data: data-transfer) -> bool;
    callback paths-of(data: data-transfer) -> [string];
}

export component FileDrop inherits Rectangle {
    in property <string> title: @tr("Drop the file here");
    in property <string> hint: @tr("Drag from the file manager or pick with the button.");
    in-out property <string> path;
    in property <bool> many: false;
    in property <bool> compact: false;
    callback dropped([string]);
    callback browse();
    function take(paths: [string]) {
        if paths.length > 0 {
            root.path = paths[0];
            root.dropped(paths);
        }
    }
    min-height: root.compact ? 56px : 92px;
    border-radius: Theme.radius;
    border-width: 1px;
    property <bool> armed: drop.has-drag || Files.hovering;
    border-color: root.armed ? Theme.accent : Theme.border-strong;
    background: root.armed ? Theme.accent-soft : Theme.field;
    animate background, border-color { duration: 120ms; easing: ease-out; }
    VerticalLayout {
        padding-left: root.compact ? 10px : 14px;
        padding-right: 132px;
        padding-top: root.compact ? 8px : 12px;
        padding-bottom: root.compact ? 8px : 12px;
        spacing: 5px;
        alignment: center;
        if !root.compact : Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: root.armed ? Theme.accent : Theme.accent-soft;
            Icon {
                x: 7px;
                y: 7px;
                width: 22px;
                height: 22px;
                name: "folder";
                fill: root.armed ? Theme.on-accent : Theme.text-dim;
            }
        }
        Text {
            text: root.armed ? @tr("Drop…") : root.title;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        if !root.compact : Text {
            text: root.hint;
            font-size: 10px;
            color: Theme.text-faint;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if !root.compact && root.path != "" : Text {
            text: root.path;
            font-size: 10px;
            font-family: Theme.mono;
            color: Theme.text-dim;
            overflow: elide;
            horizontal-alignment: center;
        }
    }
    // After the text so it sits on top and actually receives the OS drag.
    drop := DropArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        // Linux file managers often only allow move. Returning copy gets clamped
        // to none and the cursor becomes "not allowed".
        can-drop(ev) => ev.proposed-action;
        dropped(ev) => {
            root.take(Files.paths-of(ev.data));
            return ev.proposed-action;
        }
    }
    // After DropArea so the click reaches the button, not the OS drop target.
    ToolButton {
        width: 116px;
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        icon: "folder";
        text: @tr("Browse…");
        clicked => { root.browse(); }
    }
}

export component PathDialog inherits Window {
    title: root.heading;
    icon: @image-url("../assets/icon.png");
    preferred-width: 520px;
    background: Theme.bg;
    in property <string> heading: @tr("File");
    in property <string> hint;
    in property <string> accept: @tr("OK");
    in-out property <string> path;
    in property <string> error;
    callback save(string);
    callback cancel();
    callback browse();
    public function sync-palette() {
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
    }
    init => { root.sync-palette(); }

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text {
            text: root.heading;
            font-size: 17px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: root.hint;
            font-size: 12px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        FileDrop {
            title: @tr("Drop the file or folder here");
            path: root.path;
            dropped(paths) => {
                if paths.length > 0 {
                    root.path = paths[0];
                }
            }
            browse => { root.browse(); }
        }
        Field {
            label: @tr("Or type the path");
            path-edit := LineEdit {
                text <=> root.path;
                placeholder-text: "/path/to/file";
                accepted(t) => { root.save(t); }
            }
        }
        Text {
            text: root.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            ToolButton {
                text: @tr("Cancel");
                flat: true;
                clicked => { root.cancel(); }
            }
            ToolButton {
                text: root.accept;
                primary: true;
                enabled: root.path != "";
                clicked => { root.save(root.path); }
            }
        }
    }
}
