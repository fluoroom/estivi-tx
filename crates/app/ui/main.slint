import { ComboBox, CheckBox, LineEdit, SpinBox, TextEdit, ScrollView, Palette } from "std-widgets.slint";
import { Theme, ToolButton, Field, PanelTitle, Pill } from "theme.slint";
import { CardItem, PicItem, StepItem } from "types.slint";

component DayColumn inherits Rectangle {
    in property <int> cell;
    in property <bool> timed;
    in property <string> heading;
    in property <bool> today;
    in property <[CardItem]> cards;
    callback select-card(int);
    callback open-card(int);
    callback edge(int, bool, int);
    callback create-at(int, int);
    background: root.today ? Theme.accent.transparentize(0.9) : Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    property <int> press-minute: 12 * 60;

    VerticalLayout {
        PanelTitle {
            text: root.heading;
            height: 18px;
        }
        Rectangle {
            vertical-stretch: 1;
            bg := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.press-minute = min(1439, max(0, round(self.mouse-y / self.height * 1440)));
                    }
                }
                double-clicked => { root.create-at(root.cell, root.press-minute); }
            }
            for card[i] in root.cards : Rectangle {
                x: 3px;
                width: parent.width - 6px;
                y: root.timed ? card.y * parent.height : 2px + card.stack * 22px;
                height: root.timed ? max(18px, card.h * parent.height) : 20px;
                visible: card.cell == root.cell;
                border-radius: Theme.radius;
                background: rgb(card.r, card.g, card.b).transparentize(1 - card.opacity);
                border-width: 1px;
                border-color: Theme.border-strong;
                clip: true;
                Text {
                    x: 4px;
                    width: parent.width - 8px;
                    text: card.name + "  " + card.hours;
                    font-size: 11px;
                    color: #ffffff;
                    vertical-alignment: center;
                    overflow: elide;
                }
                card-touch := TouchArea {
                    property <bool> dragging: false;
                    property <bool> drag-end: false;
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            self.drag-end = root.timed && self.mouse-y > self.height - 8px;
                            self.dragging = root.timed && (self.mouse-y < 8px || self.drag-end);
                            if !self.dragging { root.select-card(card.idx); }
                        }
                        if e.kind == PointerEventKind.up && self.dragging {
                            root.edge(card.idx, self.drag-end, min(1439, max(0, round(card.y * 1440 + (self.mouse-y / max(self.height, 1px)) * card.h * 1440))));
                            self.dragging = false;
                        }
                    }
                    double-clicked => { root.open-card(card.idx); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: root.project-name == "" ? "Estivi" : "Estivi — " + root.project-name;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 980px;
    min-height: 640px;
    background: Theme.bg;

    in-out property <string> project-name;
    in-out property <string> callsign;
    in-out property <bool> dirty;
    in-out property <string> on-air: @tr("Standby");
    in-out property <string> next-up;
    in-out property <bool> agenda;
    in-out property <bool> busy;
    in-out property <string> busy-reason;
    in-out property <string> clock-note;
    in-out property <string> note;
    in-out property <int> zoom: 0;
    in-out property <string> period;
    in-out property <[string]> heads;
    in-out property <int> columns: 7;
    in-out property <int> rows: 6;
    in-out property <int> today-cell: -1;
    in-out property <[CardItem]> cards;
    in-out property <int> side: 0;
    in-out property <string> block-title;
    in-out property <bool> has-block;
    in-out property <bool> is-program;
    in-out property <[PicItem]> pics;
    in-out property <[StepItem]> steps;
    in-out property <string> tx-total;
    in-out property <bool> block-on: true;
    in-out property <bool> program-on: true;
    in-out property <string> form-name;
    in-out property <string> form-start;
    in-out property <string> form-end;
    in-out property <string> form-ends;
    in-out property <string> form-welcome;
    in-out property <string> form-bye;
    in-out property <int> form-hue: 210;
    in-out property <bool> wd0;
    in-out property <bool> wd1;
    in-out property <bool> wd2;
    in-out property <bool> wd3;
    in-out property <bool> wd4;
    in-out property <bool> wd5;
    in-out property <bool> wd6;
    in-out property <string> channel-name;
    in-out property <string> call-text;
    in-out property <string> op-text;
    in-out property <string> qth-text;
    in-out property <string> loc-text;
    in-out property <string> freq-text;
    in-out property <int> interval: 6;
    in-out property <int> offset-s;
    in-out property <int> mode-index;
    in-out property <[string]> modes;
    in-out property <int> pause-s: 60;
    in-out property <bool> vox;
    in-out property <bool> cw-pre;
    in-out property <bool> cw-id: true;
    in-out property <string> cw-text: "DE {call}";
    in-out property <bool> ax-info;
    in-out property <bool> ax-mode;
    in-out property <int> next-count: 8;
    in-out property <int> next-hours: 6;
    in-out property <bool> dedupe;
    in-out property <int> tz-index;
    in-out property <bool> instant-ok: true;
    in-out property <string> instant-why;
    in-out property <string> instant-path;
    in-out property <int> instant-mode;
    in-out property <bool> instant-cw: true;
    in-out property <bool> instant-ax;
    in-out property <string> instant-pre;
    in-out property <string> instant-post;
    in-out property <int> instant-pre-mode;
    in-out property <int> instant-post-mode;
    in-out property <string> act-list;
    in-out property <string> program-list;
    in-out property <string> ptt-note;
    in-out property <int> ptt-index: 1;
    in-out property <string> ptt-port;
    in-out property <int> lead-ms: 200;
    in-out property <int> tail-ms: 200;
    in-out property <string> cat-host: "127.0.0.1";
    in-out property <int> cat-port: 4532;
    in-out property <bool> cat-freq;
    in-out property <string> audio-out;
    in-out property <string> audio-in;
    in-out property <int> lang-index;
    in-out property <bool> ntp-on;
    in-out property <string> ntp-server: "pool.ntp.org";
    in-out property <int> ntp-hours: 6;
    in-out property <string> log-text;
    in-out property <string> listen-text;
    in-out property <image> on-air-image;
    in-out property <bool> has-image;

    in-out property <int> dialog: 0;
    in-out property <string> dialog-title;
    in-out property <string> dialog-body;
    in-out property <string> dialog-ok;
    in-out property <string> dialog-alt;
    in-out property <string> dialog-extra;
    in-out property <string> dlg-name;
    in-out property <string> dlg-date;
    in-out property <string> dlg-start;
    in-out property <string> dlg-end;
    in-out property <string> dlg-horizon;
    in-out property <string> exp-from;
    in-out property <string> exp-to;
    in-out property <int> exp-shape;
    in-out property <int> exp-rate: 2;
    in-out property <int> exp-slice: 600;
    in-out property <string> exp-note;
    in-out property <string> act-name;
    in-out property <string> act-code;
    in-out property <string> act-script;
    in-out property <int> act-source;
    in-out property <bool> act-on: true;

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-as();
    callback open-editor();
    callback open-modes();
    callback set-light(bool);
    callback set-agenda(bool);
    callback stop();
    callback set-zoom(int);
    callback nav(int);
    callback select-card(int);
    callback open-card(int);
    callback edge(int, bool, int);
    callback create-at(int, int);
    callback set-field(string, string);
    callback set-num(string, int);
    callback pic(string, int);
    callback pick(string);
    callback confirm(int);
    callback transmit();
    callback edit-activation(int);
    callback files-ready(string, [string]);
    callback saved-as(string);
    callback opened(string);
    callback run-export(string);
    callback hold-export(string);
    public function sync-palette() {
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
    }
    init => { root.sync-palette(); }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 36px;
            spacing: 6px;
            Text {
                text: "Estivi";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                text: root.project-name + (root.dirty ? " ·" : "");
                font-size: 14px;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.callsign != "" : Pill { text: root.callsign; tone: Theme.accent; }
            Rectangle { horizontal-stretch: 1; }
            ToolButton { text: @tr("New"); clicked => { root.new-project(); } }
            ToolButton { text: @tr("Open"); clicked => { root.open-project(); } }
            ToolButton { text: @tr("Save"); primary: root.dirty; clicked => { root.save-project(); } }
            ToolButton { text: @tr("Graphics"); clicked => { root.open-editor(); } }
            ToolButton { text: @tr("Modes"); clicked => { root.open-modes(); } }
            ToolButton {
                text: Theme.light ? @tr("Dark") : @tr("Light");
                clicked => {
                    root.set-light(!Theme.light);
                    root.sync-palette();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 64px;
            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: root.busy ? Theme.on-air : Theme.border;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    if root.has-image : Image {
                        source: root.on-air-image;
                        width: 72px;
                        height: 48px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: @tr("On air"); font-size: 11px; color: Theme.text-faint; }
                        Text { text: root.on-air; font-size: 16px; font-weight: 700; color: root.busy ? Theme.on-air : Theme.text; }
                    }
                    Rectangle { width: 1px; background: Theme.border; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: @tr("Next"); font-size: 11px; color: Theme.text-faint; }
                        Text { text: root.next-up; font-size: 14px; color: Theme.text; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: root.clock-note; font-size: 11px; color: Theme.text-dim; }
                        HorizontalLayout {
                            spacing: 6px;
                            CheckBox {
                                text: @tr("Grid on air");
                                checked: root.agenda;
                                toggled => { root.set-agenda(self.checked); }
                            }
                            ToolButton { text: @tr("Stop"); danger: true; enabled: root.busy; clicked => { root.stop(); } }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    ToolButton { text: @tr("Month"); active: root.zoom == 0; clicked => { root.set-zoom(0); } }
                    ToolButton { text: @tr("Week"); active: root.zoom == 1; clicked => { root.set-zoom(1); } }
                    ToolButton { text: @tr("Day"); active: root.zoom == 2; clicked => { root.set-zoom(2); } }
                    ToolButton { text: "‹"; clicked => { root.nav(-1); } }
                    Text {
                        text: root.period;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ToolButton { text: "›"; clicked => { root.nav(1); } }
                    ToolButton { text: @tr("Today"); clicked => { root.nav(0); } }
                }
                if root.zoom == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 2px;
                    for week in 6 : HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 2px;
                        for col in 7 : DayColumn {
                            horizontal-stretch: 1;
                            cell: week * 7 + col;
                            timed: false;
                            today: week * 7 + col == root.today-cell;
                            heading: root.heads[week * 7 + col];
                            cards: root.cards;
                            select-card(i) => { root.select-card(i); }
                            open-card(i) => { root.open-card(i); }
                            edge(i, end, m) => { root.edge(i, end, m); }
                            create-at(c, m) => { root.create-at(c, m); }
                        }
                    }
                }
                if root.zoom != 0 : HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 2px;
                    for col in root.columns : DayColumn {
                        horizontal-stretch: 1;
                        cell: col;
                        timed: true;
                        today: col == root.today-cell;
                        heading: root.heads[col];
                        cards: root.cards;
                        select-card(i) => { root.select-card(i); }
                        open-card(i) => { root.open-card(i); }
                        edge(i, end, m) => { root.edge(i, end, m); }
                        create-at(c, m) => { root.create-at(c, m); }
                    }
                }
            }

            Rectangle {
                width: 400px;
                background: Theme.panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 4px;
                        ToolButton { text: @tr("Block"); active: root.side == 0; clicked => { root.side = 0; } }
                        ToolButton { text: @tr("Instant"); active: root.side == 1; clicked => { root.side = 1; } }
                        ToolButton { text: @tr("Activations"); active: root.side == 2; clicked => { root.side = 2; } }
                        ToolButton { text: @tr("Channel"); active: root.side == 3; clicked => { root.side = 3; } }
                        ToolButton { text: @tr("Equipment"); active: root.side == 4; clicked => { root.side = 4; } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;
                            if root.side == 0 : VerticalLayout {
                                spacing: 8px;
                                if !root.has-block : Text {
                                    text: @tr("Double-click an empty hour to create a block, or click a card.");
                                    color: Theme.text-dim;
                                    wrap: word-wrap;
                                    font-size: 13px;
                                }
                                if root.has-block : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: root.block-title; font-size: 15px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                                    Field {
                                        label: @tr("Name");
                                        LineEdit { text: root.form-name; edited(v) => { root.form-name = v; root.set-field("name", v); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field {
                                            label: @tr("Start");
                                            LineEdit { text: root.form-start; edited(v) => { root.form-start = v; root.set-field("start", v); } }
                                        }
                                        Field {
                                            label: @tr("End");
                                            LineEdit { text: root.form-end; edited(v) => { root.form-end = v; root.set-field("end", v); } }
                                        }
                                    }
                                    CheckBox { text: @tr("This day"); checked: root.block-on; toggled => { root.set-field("enabled", self.checked ? "1" : "0"); } }
                                    if root.is-program : CheckBox { text: @tr("Program enabled"); checked: root.program-on; toggled => { root.set-field("program-on", self.checked ? "1" : "0"); } }
                                    if root.is-program : VerticalLayout {
                                        spacing: 6px;
                                        PanelTitle { text: @tr("Weekdays"); }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            CheckBox { text: @tr("Mo"); checked: root.wd0; toggled => { root.set-field("wd", self.checked ? "0:1" : "0:0"); } }
                                            CheckBox { text: @tr("Tu"); checked: root.wd1; toggled => { root.set-field("wd", self.checked ? "1:1" : "1:0"); } }
                                            CheckBox { text: @tr("We"); checked: root.wd2; toggled => { root.set-field("wd", self.checked ? "2:1" : "2:0"); } }
                                            CheckBox { text: @tr("Th"); checked: root.wd3; toggled => { root.set-field("wd", self.checked ? "3:1" : "3:0"); } }
                                            CheckBox { text: @tr("Fr"); checked: root.wd4; toggled => { root.set-field("wd", self.checked ? "4:1" : "4:0"); } }
                                            CheckBox { text: @tr("Sa"); checked: root.wd5; toggled => { root.set-field("wd", self.checked ? "5:1" : "5:0"); } }
                                            CheckBox { text: @tr("Su"); checked: root.wd6; toggled => { root.set-field("wd", self.checked ? "6:1" : "6:0"); } }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Field {
                                                label: @tr("Hue");
                                                SpinBox { minimum: 0; maximum: 359; value: root.form-hue; edited(v) => { root.form-hue = v; root.set-num("hue", v); } }
                                            }
                                            Field {
                                                label: @tr("Ends (empty = forever)");
                                                LineEdit { text: root.form-ends; edited(v) => { root.form-ends = v; root.set-field("ends", v); } }
                                            }
                                        }
                                        Text { text: @tr("Welcome") + ": " + root.form-welcome; font-size: 12px; color: Theme.text-dim; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                        ToolButton { text: @tr("Set welcome"); clicked => { root.pick("welcome"); } }
                                        ToolButton { text: @tr("Mode"); clicked => { root.set-field("welcome-mode", ""); } }
                                        ToolButton { text: @tr("Clear"); clicked => { root.set-field("welcome", ""); } }
                                        }
                                        Text { text: @tr("Bye") + ": " + root.form-bye; font-size: 12px; color: Theme.text-dim; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                        ToolButton { text: @tr("Set bye"); clicked => { root.pick("bye"); } }
                                        ToolButton { text: @tr("Mode"); clicked => { root.set-field("bye-mode", ""); } }
                                        ToolButton { text: @tr("Clear"); clicked => { root.set-field("bye", ""); } }
                                        }
                                        ToolButton { text: @tr("Delete program"); danger: true; clicked => { root.set-field("delete-program", ""); } }
                                    }
                                    if !root.is-program : ToolButton { text: @tr("Delete block"); danger: true; clicked => { root.set-field("delete-block", ""); } }
                                    PanelTitle { text: @tr("Pictures"); }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ToolButton { text: @tr("Add"); clicked => { root.pick("images"); } }
                                        ToolButton { text: @tr("Import folder"); clicked => { root.pick("folder"); } }
                                        ToolButton { text: @tr("Link up"); clicked => { root.pic("link-up", -1); } }
                                        ToolButton { text: @tr("Link down"); clicked => { root.pic("link-down", -1); } }
                                        ToolButton { text: @tr("Unlink"); clicked => { root.pic("unlink", -1); } }
                                    }
                                    for pic in root.pics : Rectangle {
                                        height: 28px;
                                        background: pic.role == 0 ? Theme.panel-raised : transparent;
                                        border-radius: Theme.radius;
                                        HorizontalLayout {
                                            padding-left: pic.role == 0 ? 6px : 18px;
                                            padding-right: 4px;
                                            spacing: 4px;
                                            Text {
                                                text: pic.label;
                                                font-size: 12px;
                                                color: pic.on ? Theme.text : Theme.text-faint;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text { text: pic.detail; font-size: 11px; color: Theme.text-dim; vertical-alignment: center; }
                                            TouchArea {
                                                property <length> y0;
                                                property <bool> armed;
                                                pointer-event(e) => {
                                                    if e.kind == PointerEventKind.down { self.y0 = self.mouse-y; self.armed = true; root.pic("select", pic.id); }
                                                    if e.kind == PointerEventKind.up && self.armed {
                                                        root.pic("nudge", round((self.mouse-y - self.y0) / 28px));
                                                        self.armed = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ToolButton { text: @tr("Up"); clicked => { root.pic("up", -1); } }
                                        ToolButton { text: @tr("Down"); clicked => { root.pic("down", -1); } }
                                        ToolButton { text: @tr("On/off"); clicked => { root.pic("toggle", -1); } }
                                        ToolButton { text: @tr("Mode"); clicked => { root.pic("mode", -1); } }
                                        ToolButton { text: @tr("Remove"); clicked => { root.pic("remove", -1); } }
                                    }
                                    PanelTitle { text: @tr("One transmission"); }
                                    for step in root.steps : HorizontalLayout {
                                        Text { text: step.label; font-size: 12px; color: step.dim ? Theme.text-faint : Theme.text; horizontal-stretch: 1; }
                                        Text { text: step.time; font-size: 12px; font-family: Theme.mono; color: Theme.text-dim; }
                                    }
                                    Text { text: root.tx-total; font-size: 12px; font-weight: 600; color: Theme.text; }
                                }
                            }
                            if root.side == 1 : VerticalLayout {
                                spacing: 8px;
                                Text { text: @tr("Instant transmission is outside the grid. A block end does not cut it."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                                if !root.instant-ok : Text { text: root.instant-why; color: Theme.on-air; font-size: 13px; wrap: word-wrap; }
                                ToolButton { text: @tr("Use the selected picture"); clicked => { root.pick("from-block"); } }
                                Text { text: root.instant-path; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                                ToolButton { text: @tr("Choose picture"); clicked => { root.pick("instant"); } }
                                Field {
                                    label: @tr("Mode");
                                    ComboBox { model: root.modes; current-index: root.instant-mode; selected => { root.instant-mode = self.current-index; } }
                                }
                                CheckBox { text: @tr("CW identification"); checked: root.instant-cw; toggled => { root.instant-cw = self.checked; } }
                                CheckBox { text: @tr("AX.25 info"); checked: root.instant-ax; toggled => { root.instant-ax = self.checked; } }
                                Text { text: @tr("Pre bumper") + ": " + root.instant-pre; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                                ToolButton { text: @tr("Set pre bumper"); clicked => { root.pick("pre"); } }
                                ComboBox { model: root.modes; current-index: root.instant-pre-mode; selected => { root.instant-pre-mode = self.current-index; } }
                                Text { text: @tr("Post bumper") + ": " + root.instant-post; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                                ToolButton { text: @tr("Set post bumper"); clicked => { root.pick("post"); } }
                                ComboBox { model: root.modes; current-index: root.instant-post-mode; selected => { root.instant-post-mode = self.current-index; } }
                                ToolButton { text: @tr("Transmit"); primary: true; enabled: root.instant-ok; clicked => { root.transmit(); } }
                            }
                            if root.side == 2 : VerticalLayout {
                                spacing: 8px;
                                Text { text: @tr("Activations are not on the grid. Triggers are OR. Pause does not cut a transmission already on the air."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                                Text { text: root.act-list; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    ToolButton { text: @tr("New activation"); clicked => { root.edit-activation(-1); } }
                                    ToolButton { text: @tr("Edit"); clicked => { root.edit-activation(0); } }
                                    ToolButton { text: "‹"; clicked => { root.pic("act", -1); } }
                                    ToolButton { text: "›"; clicked => { root.pic("act", 1); } }
                                    ToolButton { text: @tr("Remove"); clicked => { root.pic("act-remove", 0); } }
                                }
                            }
                            if root.side == 3 : VerticalLayout {
                                spacing: 8px;
                                Field { label: @tr("Channel name"); LineEdit { text: root.channel-name; edited(v) => { root.channel-name = v; root.set-field("channel", v); } } }
                                Field { label: @tr("Callsign"); LineEdit { text: root.call-text; edited(v) => { root.call-text = v; root.set-field("call", v); } } }
                                Field { label: @tr("Operator"); LineEdit { text: root.op-text; edited(v) => { root.op-text = v; root.set-field("op", v); } } }
                                Field { label: @tr("QTH"); LineEdit { text: root.qth-text; edited(v) => { root.qth-text = v; root.set-field("qth", v); } } }
                                Field { label: @tr("Locator"); LineEdit { text: root.loc-text; edited(v) => { root.loc-text = v; root.set-field("loc", v); } } }
                                Field { label: @tr("Frequency (MHz, 0 = do not retune)"); LineEdit { text: root.freq-text; edited(v) => { root.freq-text = v; root.set-field("freq", v); } } }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Field { label: @tr("Interval (minutes)"); SpinBox { minimum: 0; maximum: 180; value: root.interval; edited(v) => { root.interval = v; root.set-num("interval", v); } } }
                                    Field { label: @tr("Offset (seconds)"); SpinBox { minimum: 0; maximum: 3600; value: root.offset-s; edited(v) => { root.offset-s = v; root.set-num("offset", v); } } }
                                }
                                Field { label: @tr("Mode"); ComboBox { model: root.modes; current-index: root.mode-index; selected => { root.mode-index = self.current-index; root.set-num("mode", self.current-index); } } }
                                Field { label: @tr("Minimum pause (seconds)"); SpinBox { minimum: 0; maximum: 600; value: root.pause-s; edited(v) => { root.pause-s = v; root.set-num("pause", v); } } }
                                CheckBox { text: @tr("VOX preamble"); checked: root.vox; toggled => { root.set-field("vox", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("CW before the pictures"); checked: root.cw-pre; toggled => { root.set-field("cw-pre", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("CW after the pictures"); checked: root.cw-id; toggled => { root.set-field("cw-id", self.checked ? "1" : "0"); } }
                                Field { label: @tr("CW text"); LineEdit { text: root.cw-text; edited(v) => { root.cw-text = v; root.set-field("cw-text", v); } } }
                                CheckBox { text: @tr("AX.25 info frame"); checked: root.ax-info; toggled => { root.set-field("ax-info", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("AX.25 mode frame"); checked: root.ax-mode; toggled => { root.set-field("ax-mode", self.checked ? "1" : "0"); } }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Field { label: @tr("Upcoming blocks"); SpinBox { minimum: 1; maximum: 40; value: root.next-count; edited(v) => { root.next-count = v; root.set-num("next-count", v); } } }
                                    Field { label: @tr("or hours"); SpinBox { minimum: 1; maximum: 48; value: root.next-hours; edited(v) => { root.next-hours = v; root.set-num("next-hours", v); } } }
                                }
                                CheckBox { text: @tr("One upcoming block per program"); checked: root.dedupe; toggled => { root.set-field("dedupe", self.checked ? "1" : "0"); } }
                                Field { label: @tr("Grid timezone"); ComboBox { model: [@tr("UTC"), @tr("Local")]; current-index: root.tz-index; selected => { root.tz-index = self.current-index; root.set-num("tz", self.current-index); } } }
                                Text { text: root.program-list; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    ToolButton { text: @tr("New program"); clicked => { root.set-field("new-program", ""); } }
                                    ToolButton { text: "‹"; clicked => { root.pic("prog", -1); } }
                                    ToolButton { text: "›"; clicked => { root.pic("prog", 1); } }
                                    ToolButton { text: @tr("Edit"); clicked => { root.pic("prog-edit", 0); } }
                                }
                                ToolButton { text: @tr("Export audio"); clicked => { root.set-field("export", ""); } }
                            }
                            if root.side == 4 : VerticalLayout {
                                spacing: 8px;
                                Text { text: root.ptt-note; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                                Field { label: @tr("PTT"); ComboBox { model: [@tr("None"), @tr("VOX"), @tr("Serial"), @tr("CAT")]; current-index: root.ptt-index; selected => { root.ptt-index = self.current-index; root.set-num("ptt", self.current-index); } } }
                                Field { label: @tr("Serial port"); LineEdit { text: root.ptt-port; edited(v) => { root.ptt-port = v; root.set-field("port", v); } } }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Field { label: @tr("Lead (ms)"); SpinBox { minimum: 0; maximum: 5000; value: root.lead-ms; edited(v) => { root.lead-ms = v; root.set-num("lead", v); } } }
                                    Field { label: @tr("Tail (ms)"); SpinBox { minimum: 0; maximum: 5000; value: root.tail-ms; edited(v) => { root.tail-ms = v; root.set-num("tail", v); } } }
                                }
                                Field { label: @tr("rigctld host"); LineEdit { text: root.cat-host; edited(v) => { root.cat-host = v; root.set-field("cat-host", v); } } }
                                Field { label: @tr("rigctld port"); SpinBox { minimum: 1; maximum: 65535; value: root.cat-port; edited(v) => { root.cat-port = v; root.set-num("cat-port", v); } } }
                                CheckBox { text: @tr("Set the channel frequency before each grid transmission"); checked: root.cat-freq; toggled => { root.set-field("cat-freq", self.checked ? "1" : "0"); } }
                                Field { label: @tr("Audio output (empty = default)"); LineEdit { text: root.audio-out; edited(v) => { root.audio-out = v; root.set-field("audio-out", v); } } }
                                Field { label: @tr("Audio input (empty = default)"); LineEdit { text: root.audio-in; edited(v) => { root.audio-in = v; root.set-field("audio-in", v); } } }
                                Field { label: @tr("Language"); ComboBox { model: [@tr("English"), @tr("Spanish")]; current-index: root.lang-index; selected => { root.lang-index = self.current-index; root.set-num("lang", self.current-index); } } }
                                PanelTitle { text: @tr("Clock"); }
                                Text { text: @tr("The computer clock is not changed. Estivi stores an NTP offset and uses it for the grid."); font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                                CheckBox { text: @tr("Correct the clock"); checked: root.ntp-on; toggled => { root.set-field("ntp", self.checked ? "1" : "0"); } }
                                Field { label: @tr("NTP server"); LineEdit { text: root.ntp-server; edited(v) => { root.ntp-server = v; root.set-field("ntp-server", v); } } }
                                Field { label: @tr("Every (hours)"); SpinBox { minimum: 1; maximum: 48; value: root.ntp-hours; edited(v) => { root.ntp-hours = v; root.set-num("ntp-hours", v); } } }
                            }
                        }
                    }
                }
            }
        }

        Text { text: root.note; font-size: 12px; color: Theme.text-dim; overflow: elide; height: 16px; }
        HorizontalLayout {
            spacing: 12px;
            height: 36px;
            Text { text: root.listen-text; font-size: 11px; color: Theme.text-dim; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.log-text; font-size: 11px; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        }
    }

    if root.dialog != 0 : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;
        TouchArea {}
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 460px;
                    background: Theme.panel;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: root.dialog-title; font-size: 16px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                        if root.dialog-body != "" : Text { text: root.dialog-body; font-size: 13px; color: Theme.text-dim; wrap: word-wrap; }
                        if root.dialog == 2 : VerticalLayout {
                            spacing: 8px;
                            Field { label: @tr("Name"); LineEdit { text: root.dlg-name; edited(v) => { root.dlg-name = v; } } }
                            Field { label: @tr("Date"); LineEdit { text: root.dlg-date; edited(v) => { root.dlg-date = v; } } }
                            HorizontalLayout {
                                spacing: 8px;
                                Field { label: @tr("Start"); LineEdit { text: root.dlg-start; edited(v) => { root.dlg-start = v; } } }
                                Field { label: @tr("End"); LineEdit { text: root.dlg-end; edited(v) => { root.dlg-end = v; } } }
                            }
                        }
                        if root.dialog == 3 : Field { label: @tr("Also keep empty days until"); LineEdit { text: root.dlg-horizon; edited(v) => { root.dlg-horizon = v; } } }
                        if root.dialog == 4 : VerticalLayout {
                            spacing: 8px;
                            Field { label: @tr("From"); LineEdit { text: root.exp-from; edited(v) => { root.exp-from = v; } } }
                            Field { label: @tr("To"); LineEdit { text: root.exp-to; edited(v) => { root.exp-to = v; } } }
                            Field {
                                label: @tr("Shape");
                                ComboBox {
                                    model: [@tr("Whole file"), @tr("Each transmission and each silence"), @tr("Each piece"), @tr("Slices"), @tr("One file per block")];
                                    current-index: root.exp-shape;
                                    selected => { root.exp-shape = self.current-index; }
                                }
                            }
                            Field { label: @tr("Seconds per slice"); SpinBox { minimum: 1; maximum: 7200; value: root.exp-slice; edited(v) => { root.exp-slice = v; } } }
                            Field {
                                label: @tr("Sample rate");
                                ComboBox {
                                    model: ["11025", "22050", "44100", "48000"];
                                    current-index: root.exp-rate;
                                    selected => { root.exp-rate = self.current-index; }
                                }
                            }
                            Text { text: root.exp-note; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                        }
                        if root.dialog == 7 : VerticalLayout {
                            spacing: 8px;
                            CheckBox { text: @tr("Enabled"); checked: root.act-on; toggled => { root.act-on = self.checked; } }
                            Field { label: @tr("Name"); LineEdit { text: root.act-name; edited(v) => { root.act-name = v; } } }
                            Field { label: @tr("Trigger"); ComboBox { model: [@tr("DTMF"), @tr("CW")]; current-index: root.act-source; selected => { root.act-source = self.current-index; } } }
                            Field { label: @tr("Code"); LineEdit { text: root.act-code; edited(v) => { root.act-code = v; } } }
                            Field {
                                label: @tr("Actions, one per line");
                                TextEdit { text: root.act-script; height: 120px; wrap: no-wrap; edited(v) => { root.act-script = v; } }
                            }
                            Text { text: @tr("cw text · dtmf 123 · image path · pause · resume · ax25 comment · command cw|the line · api cw|https://… · random a.png|b.png"); font-size: 11px; color: Theme.text-faint; wrap: word-wrap; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if root.dialog-ok != "" : ToolButton { text: root.dialog-ok; primary: true; clicked => { root.confirm(0); } }
                            if root.dialog-alt != "" : ToolButton { text: root.dialog-alt; clicked => { root.confirm(1); } }
                            if root.dialog-extra != "" : ToolButton { text: root.dialog-extra; clicked => { root.confirm(2); } }
                        }
                    }
                }
            }
        }
    }
}
