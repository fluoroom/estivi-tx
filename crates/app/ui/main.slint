import { ComboBox, CheckBox, LineEdit, SpinBox, TextEdit, ScrollView, Palette } from "std-widgets.slint";
import { Theme, ToolButton, Field, MiniField, PanelTitle, Pill, BoundCombo } from "theme.slint";
import { CardItem, PicItem, StepItem, TxItem, TickItem, ActionItem } from "types.slint";

component DayColumn inherits Rectangle {
    in property <int> cell;
    in property <bool> timed;
    in property <string> heading;
    in property <bool> today;
    in property <[CardItem]> cards;
    callback select-card(int);
    callback open-card(int);
    callback edge(int, bool, int);
    callback create-at(int, int);
    callback clear();
    background: root.today ? Theme.accent.transparentize(0.9) : Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    property <int> press-minute: 12 * 60;

    VerticalLayout {
        PanelTitle {
            text: root.heading;
            height: 18px;
            overflow: elide;
        }
        Rectangle {
            vertical-stretch: 1;
            bg := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clear(); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.press-minute = min(1439, max(0, round(self.mouse-y / self.height * 1440)));
                    }
                }
                double-clicked => { root.create-at(root.cell, root.press-minute); }
            }
            for card[i] in root.cards : Rectangle {
                x: 3px;
                width: parent.width - 6px;
                y: root.timed ? card.y * parent.height : 2px + card.stack * 22px;
                height: root.timed ? max(18px, card.h * parent.height) : 20px;
                visible: card.cell == root.cell;
                border-radius: Theme.radius;
                background: rgb(card.r, card.g, card.b).transparentize(1 - card.opacity);
                border-width: card.selected ? 2px : 1px;
                border-color: card.selected ? #ffe14a : Theme.border-strong;
                clip: true;
                Text {
                    x: 4px;
                    width: parent.width - 8px;
                    text: card.name + "  " + card.hours;
                    font-size: 11px;
                    color: #ffffff;
                    vertical-alignment: center;
                    overflow: elide;
                }
                card-touch := TouchArea {
                    property <bool> dragging: false;
                    property <bool> drag-end: false;
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            self.drag-end = root.timed && self.mouse-y > self.height - 8px;
                            self.dragging = root.timed && (self.mouse-y < 8px || self.drag-end);
                            if !self.dragging { root.select-card(card.idx); }
                        }
                        if e.kind == PointerEventKind.up && self.dragging {
                            root.edge(card.idx, self.drag-end, min(1439, max(0, round(card.y * 1440 + (self.mouse-y / max(self.height, 1px)) * card.h * 1440))));
                            self.dragging = false;
                        }
                    }
                    double-clicked => { root.open-card(card.idx); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: root.project-name == "" ? "Estivi" : "Estivi — " + root.project-name;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 980px;
    min-height: 640px;
    background: Theme.bg;

    in-out property <string> project-name;
    in-out property <string> callsign;
    in-out property <bool> dirty;
    in-out property <string> on-air: @tr("Standby");
    in-out property <string> next-up;
    in-out property <bool> agenda;
    in-out property <bool> busy;
    in-out property <string> busy-reason;
    in-out property <string> clock-note;
    in-out property <string> note;
    in-out property <int> zoom: 0;
    in-out property <string> period;
    in-out property <[string]> heads;
    in-out property <int> columns: 7;
    in-out property <int> rows: 6;
    in-out property <int> today-cell: -1;
    in-out property <[CardItem]> cards;
    in-out property <int> side: 0;
    // Settings strip in the upper card: 0 channel, 1 equipment.
    in-out property <int> gear: 0;
    // 0 closed; 1 channel settings; 2 equipment settings.
    in-out property <int> settings-page: 0;
    in-out property <string> block-title;
    in-out property <bool> has-block;
    in-out property <bool> inherited;
    in-out property <bool> ghost;
    in-out property <[PicItem]> pics;
    in-out property <[StepItem]> steps;
    in-out property <string> timing-caption;
    in-out property <string> tx-total;
    in-out property <bool> block-on: true;
    in-out property <string> form-name;
    in-out property <string> form-start;
    in-out property <string> form-end;
    in-out property <string> form-when;
    in-out property <string> channel-name;
    in-out property <string> call-text;
    in-out property <string> op-text;
    in-out property <string> qth-text;
    in-out property <string> loc-text;
    in-out property <string> freq-text;
    in-out property <int> interval: 6;
    in-out property <int> offset-s;
    in-out property <int> mode-index;
    in-out property <[string]> modes;
    in-out property <int> pause-s: 60;
    in-out property <bool> vox;
    in-out property <bool> cw-pre;
    in-out property <bool> cw-id: true;
    in-out property <string> cw-text: "DE {call}";
    in-out property <bool> ax-info;
    in-out property <bool> ax-mode;
    in-out property <int> next-count: 8;
    in-out property <int> next-hours: 6;
    in-out property <bool> dedupe;
    in-out property <int> tz-index;
    in-out property <bool> instant-ok: true;
    in-out property <string> instant-why;
    in-out property <string> instant-path;
    in-out property <string> instant-file;
    in-out property <image> instant-thumb;
    in-out property <bool> instant-has-thumb;
    in-out property <bool> instant-can-use-block;
    in-out property <int> instant-mode;
    in-out property <bool> instant-cw: true;
    in-out property <bool> instant-ax;
    in-out property <string> instant-pre;
    in-out property <string> instant-pre-name;
    in-out property <bool> instant-pre-on;
    in-out property <int> instant-pre-mode;
    in-out property <string> instant-post;
    in-out property <string> instant-post-name;
    in-out property <bool> instant-post-on;
    in-out property <int> instant-post-mode;
    in-out property <string> instant-welcome;
    in-out property <string> instant-welcome-name;
    in-out property <bool> instant-welcome-on;
    in-out property <int> instant-welcome-mode;
    in-out property <string> instant-bye;
    in-out property <string> instant-bye-name;
    in-out property <bool> instant-bye-on;
    in-out property <int> instant-bye-mode;
    in-out property <[string]> instant-graphics-choices;
    in-out property <int> instant-graphics-index;
    in-out property <string> instant-graphics-hint;
    in-out property <bool> instant-graphics-edit-ok;
    in-out property <string> act-list;
    in-out property <string> ptt-note;
    in-out property <int> ptt-index: 1;
    in-out property <int> lead-ms: 200;
    in-out property <int> tail-ms: 200;
    in-out property <string> cat-host: "127.0.0.1";
    in-out property <int> cat-port: 4532;
    in-out property <bool> cat-freq;
    in-out property <[string]> audio-outs;
    in-out property <[string]> audio-ins;
    in-out property <[string]> serial-ports;
    in-out property <int> audio-out-index;
    in-out property <int> audio-in-index;
    in-out property <int> serial-index;
    in-out property <int> lang-index;
    in-out property <bool> ntp-on;
    in-out property <string> ntp-server: "pool.ntp.org";
    in-out property <int> ntp-hours: 6;
    in-out property <string> log-text;
    in-out property <string> listen-text;
    in-out property <image> on-air-image;
    in-out property <bool> has-image;
    in-out property <image> next-image;
    in-out property <bool> has-next;
    in-out property <string> next-caption;
    in-out property <string> last-log;
    in-out property <[string]> themes;
    in-out property <int> theme-index;
    in-out property <string> day-hint;
    in-out property <int> pic-mode;
    in-out property <int> block-mode;
    in-out property <[string]> mode-choices;
    in-out property <[TxItem]> clips;
    in-out property <[TickItem]> ticks;
    in-out property <int> rts-index: 1;
    in-out property <int> dtr-index;
    in-out property <float> playhead: -1;
    in-out property <[string]> act-names;
    in-out property <int> act-index;
    in-out property <[ActionItem]> actions;
    in-out property <[string]> action-kinds;
    in-out property <[string]> action-labels;
    in-out property <[string]> carriers;

    in-out property <int> dialog: 0;
    in-out property <string> dialog-title;
    in-out property <string> dialog-body;
    in-out property <string> dialog-ok;
    in-out property <string> dialog-alt;
    in-out property <string> dialog-extra;
    in-out property <string> dlg-name;
    in-out property <string> dlg-date;
    in-out property <string> dlg-start;
    in-out property <string> dlg-end;
    in-out property <int> dlg-interval: 6;
    in-out property <string> dlg-horizon;
    in-out property <string> exp-from;
    in-out property <string> exp-to;
    in-out property <int> exp-shape;
    in-out property <int> exp-rate: 2;
    in-out property <int> exp-slice: 600;
    in-out property <string> exp-note;
    in-out property <string> act-name;
    in-out property <string> act-code;
    in-out property <int> act-source;
    in-out property <bool> act-on: true;

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-as();
    callback open-editor();
    callback open-block-graphics();
    callback undo();
    callback set-theme(int);
    callback clear-selection();
    callback pick-clip(int);
    callback act-select(int);
    callback act-add(int);
    callback act-drop(int);
    callback act-edit(int, string, string);
    callback act-num(int, string, int);
    callback open-modes();
    callback open-programs(bool);
    callback set-light(bool);
    callback set-agenda(bool);
    callback stop();
    callback set-zoom(int);
    callback nav(int);
    callback select-card(int);
    callback open-card(int);
    callback edge(int, bool, int);
    callback create-at(int, int);
    callback set-field(string, string);
    callback set-num(string, int);
    callback pic(string, int);
    callback pick(string);
    callback confirm(int);
    callback transmit();
    callback edit-activation(int);
    callback refresh-devices();
    callback open-instant-graphics();
    callback files-ready(string, [string]);
    callback saved-as(string);
    callback opened(string);
    callback run-export(string);
    callback hold-export(string);
    public function sync-palette() {
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
    }
    init => { root.sync-palette(); }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 36px;
            spacing: 6px;
            alignment: start;
            Text {
                text: "Estivi";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                text: root.project-name + (root.dirty ? " ·" : "");
                font-size: 14px;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.callsign != "" : Pill { text: root.callsign; tone: Theme.accent; }
            ToolButton { text: @tr("New"); clicked => { root.new-project(); } }
            ToolButton { text: @tr("Open"); clicked => { root.open-project(); } }
            ToolButton { text: @tr("Save"); primary: root.dirty; clicked => { root.save-project(); } }
            ToolButton { text: @tr("Undo"); enabled: root.dirty; clicked => { root.undo(); } }
            ToolButton { text: @tr("Graphics"); clicked => { root.open-editor(); } }
            ToolButton { text: @tr("Programs"); clicked => { root.open-programs(false); } }
            ToolButton { text: @tr("Modes"); clicked => { root.open-modes(); } }
            ComboBox {
                model: root.themes;
                current-index: root.theme-index;
                selected => { root.theme-index = self.current-index; root.set-theme(self.current-index); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 190px;
            Rectangle {
                width: 200px;
                background: #000000;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: root.busy ? Theme.on-air : Theme.border;
                clip: true;
                if root.has-image : Image {
                    source: root.on-air-image;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
                Text {
                    x: 8px;
                    y: 6px;
                    text: @tr("Live");
                    font-size: 11px;
                    font-weight: 700;
                    color: root.busy ? Theme.on-air : #ffffffcc;
                }
            }
            Rectangle {
                width: 200px;
                background: #000000;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                if root.has-next : Image {
                    source: root.next-image;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
                VerticalLayout {
                    alignment: start;
                    padding: 6px;
                    Text { text: @tr("Next"); font-size: 11px; font-weight: 700; color: #ffffffcc; }
                    Text { text: root.next-caption; font-size: 11px; color: #ffffff; overflow: elide; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        width: 200px;
                        spacing: 4px;
                        alignment: start;
                        Text { text: root.on-air; font-size: 15px; font-weight: 700; color: root.busy ? Theme.on-air : Theme.text; overflow: elide; }
                        Text { text: root.next-up; font-size: 12px; color: Theme.text-dim; overflow: elide; }
                        Text { text: root.clock-note; font-size: 11px; color: Theme.text; overflow: elide; }
                        HorizontalLayout {
                            spacing: 6px;
                            ComboBox {
                                width: 90px;
                                model: [@tr("UTC"), @tr("Local")];
                                current-index: root.tz-index;
                                selected => { root.tz-index = self.current-index; root.set-num("tz", self.current-index); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            ToolButton {
                                text: root.agenda ? @tr("Stop grid") : @tr("Start grid");
                                primary: !root.agenda;
                                danger: root.agenda;
                                clicked => { root.set-agenda(!root.agenda); }
                            }
                            ToolButton { text: @tr("Cut"); danger: true; enabled: root.busy; clicked => { root.stop(); } }
                        }
                        Text { text: root.last-log; font-size: 10px; color: Theme.text-faint; overflow: elide; }
                    }
                    Rectangle { width: 1px; background: Theme.border; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 4px;
                            ToolButton {
                                text: @tr("Channel");
                                height: 24px;
                                active: root.gear == 0;
                                clicked => { root.gear = 0; }
                            }
                            ToolButton {
                                text: @tr("Equipment");
                                height: 24px;
                                active: root.gear == 1;
                                clicked => { root.gear = 1; root.refresh-devices(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if root.gear == 1 : ToolButton {
                                text: @tr("Refresh");
                                height: 24px;
                                clicked => { root.refresh-devices(); }
                            }
                        }
                        if root.gear == 0 : VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 6px;
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("Name");
                                    LineEdit { text: root.channel-name; height: 22px; horizontal-stretch: 1; edited(v) => { root.channel-name = v; root.set-field("channel", v); } }
                                }
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("Callsign");
                                    LineEdit { text: root.call-text; height: 22px; horizontal-stretch: 1; edited(v) => { root.call-text = v; root.set-field("call", v); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("Freq. (MHz)");
                                    LineEdit { text: root.freq-text; height: 22px; horizontal-stretch: 1; edited(v) => { root.freq-text = v; root.set-field("freq", v); } }
                                }
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("Mode");
                                    ComboBox { model: root.modes; current-index: root.mode-index; height: 22px; horizontal-stretch: 1; selected => { root.mode-index = self.current-index; root.set-num("mode", self.current-index); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("Min pause (s)");
                                    SpinBox { minimum: 0; maximum: 600; value: root.pause-s; height: 22px; horizontal-stretch: 1; edited(v) => { root.pause-s = v; root.set-num("pause", v); } }
                                }
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("CW text");
                                    LineEdit { text: root.cw-text; height: 22px; horizontal-stretch: 1; edited(v) => { root.cw-text = v; root.set-field("cw-text", v); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                ToolButton {
                                    icon: "gear";
                                    text: @tr("More channel settings…");
                                    height: 24px;
                                    clicked => { root.settings-page = 1; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        if root.gear == 1 : VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 6px;
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("PTT");
                                    ComboBox { model: [@tr("None"), @tr("VOX"), @tr("Serial"), @tr("CAT")]; current-index: root.ptt-index; height: 22px; horizontal-stretch: 1; selected => { root.ptt-index = self.current-index; root.set-num("ptt", self.current-index); } }
                                }
                                MiniField {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    label: @tr("Serial port");
                                    ComboBox { model: root.serial-ports; current-index: root.serial-index; height: 22px; horizontal-stretch: 1; selected => { root.serial-index = self.current-index; root.set-num("serial", self.current-index); } }
                                }
                            }
                            MiniField {
                                label: @tr("Audio output");
                                ComboBox { model: root.audio-outs; current-index: root.audio-out-index; height: 22px; horizontal-stretch: 1; selected => { root.audio-out-index = self.current-index; root.set-num("audio-out", self.current-index); } }
                            }
                            MiniField {
                                label: @tr("Audio input");
                                ComboBox { model: root.audio-ins; current-index: root.audio-in-index; height: 22px; horizontal-stretch: 1; selected => { root.audio-in-index = self.current-index; root.set-num("audio-in", self.current-index); } }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                ToolButton {
                                    icon: "gear";
                                    text: @tr("More equipment settings…");
                                    height: 24px;
                                    clicked => { root.settings-page = 2; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            min-height: 0px;

            VerticalLayout {
                horizontal-stretch: 1;
                min-height: 0px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    ToolButton { text: @tr("Month"); active: root.zoom == 0; clicked => { root.set-zoom(0); } }
                    ToolButton { text: @tr("Week"); active: root.zoom == 1; clicked => { root.set-zoom(1); } }
                    ToolButton { text: @tr("Day"); active: root.zoom == 2; clicked => { root.set-zoom(2); } }
                    ToolButton { text: "‹"; clicked => { root.nav(-1); } }
                    Text {
                        text: root.period;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    ToolButton { text: "›"; clicked => { root.nav(1); } }
                    ToolButton { text: @tr("Today"); clicked => { root.nav(0); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                // One column width for every week. A HorizontalLayout per week
                // sizes each day from its heading, so the borders do not meet.
                if root.zoom == 0 : month := Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    property <length> gap: 2px;
                    property <length> col-w: max(0px, (month.width - 6 * month.gap) / 7);
                    property <length> row-h: max(0px, (month.height - 5 * month.gap) / 6);
                    for week in 6 : Rectangle {
                        x: 0px;
                        y: week * (month.row-h + month.gap);
                        width: month.width;
                        height: week == 5 ? max(0px, month.height - self.y) : month.row-h;
                        for col in 7 : DayColumn {
                            x: col * (month.col-w + month.gap);
                            y: 0px;
                            width: col == 6 ? max(0px, parent.width - self.x) : month.col-w;
                            height: parent.height;
                            cell: week * 7 + col;
                            timed: false;
                            today: week * 7 + col == root.today-cell;
                            heading: root.heads[week * 7 + col];
                            cards: root.cards;
                            select-card(i) => { root.select-card(i); }
                            open-card(i) => { root.open-card(i); }
                            edge(i, end, m) => { root.edge(i, end, m); }
                            create-at(c, m) => { root.create-at(c, m); }
                            clear => { root.clear-selection(); }
                        }
                    }
                }
                if root.zoom != 0 : HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 2px;
                    for col in root.columns : DayColumn {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        cell: col;
                        timed: true;
                        today: col == root.today-cell;
                        heading: root.heads[col];
                        cards: root.cards;
                        select-card(i) => { root.select-card(i); }
                        open-card(i) => { root.open-card(i); }
                        edge(i, end, m) => { root.edge(i, end, m); }
                        create-at(c, m) => { root.create-at(c, m); }
                        clear => { root.clear-selection(); }
                    }
                }
            }

            Rectangle {
                width: 400px;
                vertical-stretch: 1;
                min-height: 0px;
                background: Theme.panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 4px;
                        ToolButton { text: @tr("Block"); active: root.side == 0; clicked => { root.side = 0; } }
                        ToolButton { text: @tr("Instant"); active: root.side == 1; clicked => { root.side = 1; } }
                        ToolButton { text: @tr("Activations"); active: root.side == 2; clicked => { root.side = 2; } }
                    }
                    if root.side == 1 : ToolButton {
                        text: @tr("Transmit");
                        primary: true;
                        enabled: root.instant-ok && root.instant-path != "";
                        clicked => { root.transmit(); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        min-height: 0px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            if root.side == 0 : VerticalLayout {
                                spacing: 8px;
                                if !root.has-block : Text {
                                    text: @tr("Double-click an empty hour for a common block, or click a card. A program's days and hours are set in Programs.");
                                    color: Theme.text-dim;
                                    wrap: word-wrap;
                                    font-size: 13px;
                                }
                                if root.has-block : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: root.block-title; font-size: 15px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                                    if !root.inherited : Field {
                                        label: @tr("Name");
                                        LineEdit { text: root.form-name; edited(v) => { root.form-name = v; root.set-field("name", v); } }
                                    }
                                    if !root.inherited : HorizontalLayout {
                                        spacing: 8px;
                                        Field {
                                            label: @tr("Start");
                                            LineEdit { text: root.form-start; edited(v) => { root.form-start = v; root.set-field("start", v); } }
                                        }
                                        Field {
                                            label: @tr("End");
                                            LineEdit { text: root.form-end; edited(v) => { root.form-end = v; root.set-field("end", v); } }
                                        }
                                    }
                                    if !root.inherited : Field {
                                        label: @tr("Image interval (minutes)");
                                        SpinBox { minimum: 0; maximum: 180; value: root.interval; edited(v) => { root.interval = v; root.set-num("interval", v); } }
                                    }
                                    if root.inherited : Text { text: root.form-when; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                                    if root.ghost : Text {
                                        text: @tr("Predicted from the program. It is saved once it has a picture, its own graphics, or its own SSTV mode.");
                                        font-size: 12px;
                                        color: Theme.text-dim;
                                        wrap: word-wrap;
                                    }
                                    if root.inherited : ToolButton { text: @tr("Programs"); clicked => { root.open-programs(true); } }
                                    CheckBox { text: @tr("Transmit this date"); checked: root.block-on; toggled => { root.set-field("enabled", self.checked ? "1" : "0"); } }
                                    Text { text: root.day-hint; font-size: 11px; color: Theme.text-faint; wrap: word-wrap; }
                                    ToolButton { text: @tr("Graphics"); clicked => { root.open-block-graphics(); } }
                                    Field {
                                        label: @tr("SSTV mode");
                                        BoundCombo {
                                            model: root.mode-choices;
                                            index: root.block-mode;
                                            selected(i) => { root.set-num("block-mode", i); }
                                        }
                                    }
                                    if !root.inherited : ToolButton { text: @tr("Delete block"); danger: true; clicked => { root.set-field("delete-block", ""); } }
                                    PanelTitle { text: @tr("Pictures"); }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ToolButton { text: @tr("Add"); clicked => { root.pick("images"); } }
                                        if root.inherited : ToolButton { text: @tr("Import folder"); clicked => { root.pick("folder"); } }
                                        ToolButton { text: @tr("Link up"); clicked => { root.pic("link-up", -1); } }
                                        ToolButton { text: @tr("Link down"); clicked => { root.pic("link-down", -1); } }
                                        ToolButton { text: @tr("Unlink"); clicked => { root.pic("unlink", -1); } }
                                    }
                                    for pic in root.pics : Rectangle {
                                        height: 30px;
                                        background: pic.selected ? Theme.accent.transparentize(0.8) : transparent;
                                        border-radius: Theme.radius;
                                        border-width: pic.selected ? 1px : 0px;
                                        border-color: Theme.accent;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            if pic.has-thumb : Image {
                                                source: pic.thumb;
                                                width: 34px;
                                                height: 24px;
                                                image-fit: contain;
                                                opacity: pic.on ? 1.0 : 0.45;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                alignment: center;
                                                spacing: 0px;
                                                Text {
                                                    text: pic.label;
                                                    font-size: 12px;
                                                    color: pic.on ? Theme.text : Theme.text-faint;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: pic.detail;
                                                    font-size: 10px;
                                                    color: Theme.text-dim;
                                                    overflow: elide;
                                                }
                                            }
                                            if pic.role != 0 : Text {
                                                text: pic.role == 1 ? @tr("Pre") : @tr("Post");
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: Theme.tx-bumper;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            property <length> y0;
                                            property <bool> armed;
                                            pointer-event(e) => {
                                                if e.kind == PointerEventKind.down { self.y0 = self.mouse-y; self.armed = true; }
                                                if e.kind == PointerEventKind.up && self.armed {
                                                    self.armed = false;
                                                    if self.mouse-y - self.y0 < 8px && self.y0 - self.mouse-y < 8px {
                                                        root.pic("select", pic.id);
                                                    } else {
                                                        root.pic("nudge", round((self.mouse-y - self.y0) / 30px));
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.pics.length == 0 : Text {
                                        text: @tr("No pictures in this block yet. Add files, or import a folder of numbered blocks.");
                                        font-size: 12px;
                                        color: Theme.text-dim;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ToolButton { text: @tr("Up"); clicked => { root.pic("up", -1); } }
                                        ToolButton { text: @tr("Down"); clicked => { root.pic("down", -1); } }
                                        ToolButton { text: @tr("On/off"); clicked => { root.pic("toggle", -1); } }
                                        ToolButton { text: @tr("Remove"); clicked => { root.pic("remove", -1); } }
                                    }
                                    Field {
                                        label: @tr("Picture mode");
                                        BoundCombo {
                                            model: root.mode-choices;
                                            index: root.pic-mode;
                                            selected(i) => { root.pic("mode", i); }
                                        }
                                    }
                                    PanelTitle { text: @tr("Timing"); }
                                    Text {
                                        text: root.timing-caption;
                                        font-size: 11px;
                                        color: Theme.text-dim;
                                        wrap: word-wrap;
                                    }
                                    for step in root.steps : HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: step.label;
                                            font-size: 12px;
                                            color: step.dim ? Theme.text-faint : Theme.text;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: step.time;
                                            font-size: 12px;
                                            font-family: Theme.mono;
                                            color: Theme.text-dim;
                                        }
                                    }
                                    Text {
                                        text: root.tx-total;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            if root.side == 1 : VerticalLayout {
                                spacing: 8px;
                                Text { text: @tr("Instant transmission is outside the grid. A block end does not cut it."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                                if !root.instant-ok : Text { text: root.instant-why; color: Theme.on-air; font-size: 13px; wrap: word-wrap; }
                                PanelTitle { text: @tr("Picture"); }
                                if root.instant-has-thumb : Rectangle {
                                    height: 120px;
                                    background: #000000;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    clip: true;
                                    Image { source: root.instant-thumb; width: 100%; height: 100%; image-fit: contain; }
                                }
                                Text {
                                    text: root.instant-file == "" ? @tr("No picture chosen.") : root.instant-file;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.instant-file == "" ? Theme.text-faint : Theme.text;
                                    wrap: word-wrap;
                                }
                                if !root.instant-has-thumb && root.instant-file != "" : Text { text: root.instant-path; font-size: 10px; color: Theme.text-faint; overflow: elide; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    ToolButton {
                                        text: @tr("Use the selected picture");
                                        enabled: root.instant-can-use-block;
                                        clicked => { root.pick("from-block"); }
                                    }
                                    ToolButton { text: @tr("Choose picture"); clicked => { root.pick("instant"); } }
                                    ToolButton { text: @tr("Clear"); enabled: root.instant-path != ""; clicked => { root.set-field("instant-clear", ""); } }
                                }
                                Field {
                                    label: @tr("Mode");
                                    ComboBox { model: root.modes; current-index: root.instant-mode; selected => { root.instant-mode = self.current-index; } }
                                }
                                PanelTitle { text: @tr("Transmission"); }
                                HorizontalLayout {
                                    spacing: 6px;
                                    CheckBox { text: @tr("CW identification"); checked: root.instant-cw; horizontal-stretch: 1; toggled => { root.instant-cw = self.checked; } }
                                    CheckBox { text: @tr("AX.25 info"); checked: root.instant-ax; horizontal-stretch: 1; toggled => { root.instant-ax = self.checked; } }
                                }
                                PanelTitle { text: @tr("Graphics"); }
                                Field {
                                    label: @tr("Paint on the picture");
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ComboBox {
                                            horizontal-stretch: 1;
                                            model: root.instant-graphics-choices;
                                            current-index: root.instant-graphics-index;
                                            selected => { root.instant-graphics-index = self.current-index; root.set-num("instant-graphics", self.current-index); }
                                        }
                                        ToolButton {
                                            text: @tr("Edit graphics");
                                            enabled: root.instant-graphics-edit-ok;
                                            clicked => { root.open-instant-graphics(); }
                                        }
                                    }
                                }
                                Text { text: root.instant-graphics-hint; font-size: 11px; color: Theme.text-dim; wrap: word-wrap; }
                                PanelTitle { text: @tr("Pre bumper"); }
                                Text { text: root.instant-pre == "" ? @tr("None") : root.instant-pre-name; font-size: 12px; color: root.instant-pre == "" ? Theme.text-faint : Theme.text; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    CheckBox {
                                        text: @tr("Include");
                                        checked: root.instant-pre-on;
                                        enabled: root.instant-pre != "";
                                        toggled => { root.instant-pre-on = self.checked; }
                                    }
                                    ToolButton { text: root.instant-pre == "" ? @tr("Choose") : @tr("Change"); clicked => { root.pick("pre"); } }
                                    ToolButton { text: @tr("Clear"); enabled: root.instant-pre != ""; clicked => { root.set-field("instant-pre-clear", ""); } }
                                }
                                if root.instant-pre != "" : Field {
                                    label: @tr("Mode");
                                    ComboBox { model: root.modes; current-index: root.instant-pre-mode; selected => { root.instant-pre-mode = self.current-index; } }
                                }
                                PanelTitle { text: @tr("Post bumper"); }
                                Text { text: root.instant-post == "" ? @tr("None") : root.instant-post-name; font-size: 12px; color: root.instant-post == "" ? Theme.text-faint : Theme.text; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    CheckBox {
                                        text: @tr("Include");
                                        checked: root.instant-post-on;
                                        enabled: root.instant-post != "";
                                        toggled => { root.instant-post-on = self.checked; }
                                    }
                                    ToolButton { text: root.instant-post == "" ? @tr("Choose") : @tr("Change"); clicked => { root.pick("post"); } }
                                    ToolButton { text: @tr("Clear"); enabled: root.instant-post != ""; clicked => { root.set-field("instant-post-clear", ""); } }
                                }
                                if root.instant-post != "" : Field {
                                    label: @tr("Mode");
                                    ComboBox { model: root.modes; current-index: root.instant-post-mode; selected => { root.instant-post-mode = self.current-index; } }
                                }
                                PanelTitle { text: @tr("Welcome and bye"); }
                                Text { text: @tr("Welcome"); font-size: 12px; font-weight: 600; color: Theme.text; }
                                Text { text: root.instant-welcome == "" ? @tr("None") : root.instant-welcome-name; font-size: 12px; color: root.instant-welcome == "" ? Theme.text-faint : Theme.text; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    CheckBox {
                                        text: @tr("Include");
                                        checked: root.instant-welcome-on;
                                        enabled: root.instant-welcome != "";
                                        toggled => { root.instant-welcome-on = self.checked; }
                                    }
                                    ToolButton { text: root.instant-welcome == "" ? @tr("Choose") : @tr("Change"); clicked => { root.pick("instant-welcome"); } }
                                    ToolButton { text: @tr("Clear"); enabled: root.instant-welcome != ""; clicked => { root.set-field("instant-welcome-clear", ""); } }
                                }
                                if root.instant-welcome != "" : Field {
                                    label: @tr("Mode");
                                    ComboBox { model: root.modes; current-index: root.instant-welcome-mode; selected => { root.instant-welcome-mode = self.current-index; } }
                                }
                                Text { text: @tr("Bye"); font-size: 12px; font-weight: 600; color: Theme.text; }
                                Text { text: root.instant-bye == "" ? @tr("None") : root.instant-bye-name; font-size: 12px; color: root.instant-bye == "" ? Theme.text-faint : Theme.text; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    CheckBox {
                                        text: @tr("Include");
                                        checked: root.instant-bye-on;
                                        enabled: root.instant-bye != "";
                                        toggled => { root.instant-bye-on = self.checked; }
                                    }
                                    ToolButton { text: root.instant-bye == "" ? @tr("Choose") : @tr("Change"); clicked => { root.pick("instant-bye"); } }
                                    ToolButton { text: @tr("Clear"); enabled: root.instant-bye != ""; clicked => { root.set-field("instant-bye-clear", ""); } }
                                }
                                if root.instant-bye != "" : Field {
                                    label: @tr("Mode");
                                    ComboBox { model: root.modes; current-index: root.instant-bye-mode; selected => { root.instant-bye-mode = self.current-index; } }
                                }
                            }
                            if root.side == 2 : VerticalLayout {
                                spacing: 8px;
                                Text { text: @tr("A matching DTMF or CW code runs the actions. Triggers are OR. Pause waits for the current transmission to finish."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                                Field {
                                    label: @tr("Activation");
                                    ComboBox { model: root.act-names; current-index: root.act-index; selected => { root.act-index = self.current-index; root.act-select(self.current-index); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    ToolButton { text: @tr("New"); clicked => { root.edit-activation(-1); } }
                                    ToolButton { text: @tr("Remove"); clicked => { root.pic("act-remove", 0); } }
                                }
                                CheckBox { text: @tr("Enabled"); checked: root.act-on; toggled => { root.act-on = self.checked; root.act-edit(-1, "on", self.checked ? "1" : "0"); } }
                                Field { label: @tr("Name"); LineEdit { text: root.act-name; edited(v) => { root.act-name = v; root.act-edit(-1, "name", v); } } }
                                Field { label: @tr("Hears"); ComboBox { model: [@tr("DTMF"), @tr("CW")]; current-index: root.act-source; selected => { root.act-source = self.current-index; root.act-edit(-1, "source", self.current-index == 0 ? "dtmf" : "cw"); } } }
                                Field { label: @tr("Code"); LineEdit { text: root.act-code; edited(v) => { root.act-code = v; root.act-edit(-1, "code", v); } } }
                                PanelTitle { text: @tr("Actions"); }
                                for act[i] in root.actions : Rectangle {
                                    background: Theme.panel-raised;
                                    border-radius: Theme.radius;
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            Text { text: root.action-labels[act.kind]; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                                            ToolButton { text: @tr("Remove"); clicked => { root.act-drop(i); } }
                                        }
                                        if act.kind == 0 || act.kind == 1 || act.kind == 5 : Field {
                                            label: act.kind == 5 ? @tr("Comment") : @tr("Text");
                                            LineEdit { text: act.text; edited(v) => { root.act-edit(i, "text", v); } }
                                        }
                                        if act.kind == 0 : HorizontalLayout {
                                            spacing: 6px;
                                            Field { label: @tr("WPM"); SpinBox { minimum: 5; maximum: 40; value: act.wpm; edited(v) => { root.act-num(i, "wpm", v); } } }
                                            Field { label: @tr("Hz"); SpinBox { minimum: 200; maximum: 2000; value: act.tone; edited(v) => { root.act-num(i, "tone", v); } } }
                                        }
                                        if act.kind == 2 || act.kind == 8 : HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: act.path; font-size: 11px; color: Theme.text-dim; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            ToolButton { text: @tr("Picture"); clicked => { root.act-edit(i, "pick", ""); } }
                                        }
                                        if act.kind == 2 : Field {
                                            label: @tr("Mode");
                                            ComboBox { model: root.modes; current-index: act.mode; selected => { root.act-num(i, "mode", self.current-index); } }
                                        }
                                        if act.kind == 6 || act.kind == 7 : Field {
                                            label: act.kind == 6 ? @tr("Command") : @tr("URL");
                                            LineEdit { text: act.kind == 6 ? act.text : act.url; edited(v) => { root.act-edit(i, act.kind == 6 ? "text" : "url", v); } }
                                        }
                                        if act.kind == 6 || act.kind == 7 : Field {
                                            label: @tr("Send the answer as");
                                            ComboBox { model: root.carriers; current-index: act.via; selected => { root.act-num(i, "via", self.current-index); } }
                                        }
                                    }
                                }
                                Field {
                                    label: @tr("Add an action");
                                    ComboBox { model: root.action-kinds; current-index: 0; selected => { if self.current-index > 0 { root.act-add(self.current-index - 1); self.current-index = 0; } } }
                                }
                            }
                            Rectangle { height: 28px; }
                        }
                    }
                }
            }
        }

        Text { text: root.note; font-size: 12px; color: Theme.text-dim; overflow: elide; height: 16px; }
        Text { text: root.listen-text; font-size: 11px; color: Theme.text-dim; overflow: elide; height: 16px; }
        if root.clips.length > 0 : Rectangle {
            height: 96px;
            background: Theme.panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            // One clip per piece: CW, AX.25, welcome, each bumper, the picture, the bye.
            // A transmission reads as its parts instead of one opaque box.
            for clip in root.clips : Rectangle {
                x: parent.width * clip.x;
                y: 4px;
                width: max(2px, parent.width * clip.w);
                height: 62px;
                property <color> tone: clip.kind == 1 ? Theme.tx-cw
                    : clip.kind == 2 || clip.kind == 3 ? Theme.tx-ax
                    : clip.kind == 5 || clip.kind == 8 ? Theme.tx-welcome
                    : clip.kind == 6 ? Theme.tx-bumper
                    : Theme.text-faint;
                background: clip.selected ? Theme.accent.transparentize(0.45)
                    : clip.kind == 7 ? Theme.panel-raised
                    : tone.transparentize(0.8);
                border-radius: 3px;
                border-width: clip.selected ? 2px : 1px;
                border-color: clip.selected ? #ffe14a : clip.kind == 7 ? Theme.border-strong : tone.transparentize(0.15);
                clip: true;
                if clip.has-thumb : Image {
                    source: clip.thumb;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                    opacity: 0.9;
                }
                if clip.has-thumb : Rectangle {
                    y: parent.height - 17px;
                    height: 17px;
                    background: #000000a8;
                }
                Text {
                    x: 3px;
                    y: clip.has-thumb ? parent.height - 15px : 3px;
                    text: clip.label;
                    font-size: 9px;
                    color: clip.has-thumb ? #ffffff : Theme.text;
                    overflow: elide;
                    width: parent.width - 6px;
                }
                if !clip.has-thumb : Text {
                    x: 3px;
                    y: 16px;
                    text: clip.detail;
                    font-size: 9px;
                    color: Theme.text-dim;
                    overflow: elide;
                    width: parent.width - 6px;
                }
                TouchArea { clicked => { root.pick-clip(clip.id); } }
            }
            for tick in root.ticks : Text {
                y: parent.height - 18px;
                x: tick.x <= 0.02 ? 4px : (tick.x >= 0.98 ? parent.width - self.width - 4px : parent.width * tick.x - self.width / 2);
                text: tick.label;
                font-size: 10px;
                font-family: Theme.mono;
                color: Theme.text-dim;
            }
            if root.playhead >= 0 && root.playhead <= 1 : Rectangle {
                x: parent.width * root.playhead - 1px;
                y: 0px;
                width: 2px;
                height: parent.height - 18px;
                background: #ffe14a;
            }
        }
    }

    // The full station configuration. The top card keeps the fields used every day;
    // this card holds the rest and needs no scrolling.
    if root.settings-page != 0 : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;
        TouchArea { clicked => { root.settings-page = 0; } }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 920px;
                    background: Theme.panel;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.settings-page == 1 ? @tr("Channel settings") : @tr("Equipment settings");
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            ToolButton { text: @tr("Close"); clicked => { root.settings-page = 0; } }
                        }
                        if root.settings-page == 1 : VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Channel name"); LineEdit { text: root.channel-name; edited(v) => { root.channel-name = v; root.set-field("channel", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Callsign"); LineEdit { text: root.call-text; edited(v) => { root.call-text = v; root.set-field("call", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Operator"); LineEdit { text: root.op-text; edited(v) => { root.op-text = v; root.set-field("op", v); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("QTH"); LineEdit { text: root.qth-text; edited(v) => { root.qth-text = v; root.set-field("qth", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Locator"); LineEdit { text: root.loc-text; edited(v) => { root.loc-text = v; root.set-field("loc", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Frequency (MHz, 0 = do not retune)"); LineEdit { text: root.freq-text; edited(v) => { root.freq-text = v; root.set-field("freq", v); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Offset (seconds)"); SpinBox { minimum: 0; maximum: 3600; value: root.offset-s; edited(v) => { root.offset-s = v; root.set-num("offset", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Mode"); ComboBox { model: root.modes; current-index: root.mode-index; selected => { root.mode-index = self.current-index; root.set-num("mode", self.current-index); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Minimum pause (seconds)"); SpinBox { minimum: 0; maximum: 600; value: root.pause-s; edited(v) => { root.pause-s = v; root.set-num("pause", v); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("CW text"); LineEdit { text: root.cw-text; edited(v) => { root.cw-text = v; root.set-field("cw-text", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Upcoming blocks"); SpinBox { minimum: 1; maximum: 40; value: root.next-count; edited(v) => { root.next-count = v; root.set-num("next-count", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("or hours"); SpinBox { minimum: 1; maximum: 48; value: root.next-hours; edited(v) => { root.next-hours = v; root.set-num("next-hours", v); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                CheckBox { text: @tr("VOX preamble"); checked: root.vox; horizontal-stretch: 1; toggled => { root.set-field("vox", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("CW before the pictures"); checked: root.cw-pre; horizontal-stretch: 1; toggled => { root.set-field("cw-pre", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("CW after the pictures"); checked: root.cw-id; horizontal-stretch: 1; toggled => { root.set-field("cw-id", self.checked ? "1" : "0"); } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                CheckBox { text: @tr("AX.25 info frame"); checked: root.ax-info; horizontal-stretch: 1; toggled => { root.set-field("ax-info", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("AX.25 mode frame"); checked: root.ax-mode; horizontal-stretch: 1; toggled => { root.set-field("ax-mode", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("One upcoming block per program"); checked: root.dedupe; horizontal-stretch: 1; toggled => { root.set-field("dedupe", self.checked ? "1" : "0"); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ToolButton { text: @tr("Export audio"); clicked => { root.settings-page = 0; root.set-field("export", ""); } }
                                Rectangle { horizontal-stretch: 1; }
                                ToolButton { text: @tr("Close"); clicked => { root.settings-page = 0; } }
                            }
                        }
                        if root.settings-page == 2 : VerticalLayout {
                            spacing: 8px;
                            Text { text: root.ptt-note; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("PTT"); ComboBox { model: [@tr("None"), @tr("VOX"), @tr("Serial"), @tr("CAT")]; current-index: root.ptt-index; selected => { root.ptt-index = self.current-index; root.set-num("ptt", self.current-index); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Serial port"); ComboBox { model: root.serial-ports; current-index: root.serial-index; selected => { root.serial-index = self.current-index; root.set-num("serial", self.current-index); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Language"); ComboBox { model: [@tr("English"), @tr("Spanish")]; current-index: root.lang-index; selected => { root.lang-index = self.current-index; root.set-num("lang", self.current-index); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: "RTS"; ComboBox { model: [@tr("Off"), "+", "−"]; current-index: root.rts-index; selected => { root.rts-index = self.current-index; root.set-num("rts", self.current-index); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: "DTR"; ComboBox { model: [@tr("Off"), "+", "−"]; current-index: root.dtr-index; selected => { root.dtr-index = self.current-index; root.set-num("dtr", self.current-index); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Lead (ms)"); SpinBox { minimum: 0; maximum: 5000; value: root.lead-ms; edited(v) => { root.lead-ms = v; root.set-num("lead", v); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Tail (ms)"); SpinBox { minimum: 0; maximum: 5000; value: root.tail-ms; edited(v) => { root.tail-ms = v; root.set-num("tail", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("rigctld host"); LineEdit { text: root.cat-host; edited(v) => { root.cat-host = v; root.set-field("cat-host", v); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("rigctld port"); SpinBox { minimum: 1; maximum: 65535; value: root.cat-port; edited(v) => { root.cat-port = v; root.set-num("cat-port", v); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Audio output"); ComboBox { model: root.audio-outs; current-index: root.audio-out-index; selected => { root.audio-out-index = self.current-index; root.set-num("audio-out", self.current-index); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Audio input"); ComboBox { model: root.audio-ins; current-index: root.audio-in-index; selected => { root.audio-in-index = self.current-index; root.set-num("audio-in", self.current-index); } } }
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("NTP server"); LineEdit { text: root.ntp-server; edited(v) => { root.ntp-server = v; root.set-field("ntp-server", v); } } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { horizontal-stretch: 1; min-width: 0px; label: @tr("Every (hours)"); SpinBox { minimum: 1; maximum: 48; value: root.ntp-hours; edited(v) => { root.ntp-hours = v; root.set-num("ntp-hours", v); } } }
                                CheckBox { text: @tr("Set the channel frequency before each grid transmission"); checked: root.cat-freq; horizontal-stretch: 2; toggled => { root.set-field("cat-freq", self.checked ? "1" : "0"); } }
                                CheckBox { text: @tr("Correct the clock"); checked: root.ntp-on; horizontal-stretch: 1; toggled => { root.set-field("ntp", self.checked ? "1" : "0"); } }
                            }
                            Text { text: @tr("The computer clock is not changed. Estivi stores an NTP offset and uses it for the grid."); font-size: 11px; color: Theme.text-faint; wrap: word-wrap; }
                            Text { text: @tr("The lists show what this computer reports. Refresh after connecting or removing a device."); font-size: 11px; color: Theme.text-faint; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                ToolButton { text: @tr("Refresh devices"); clicked => { root.refresh-devices(); } }
                                Rectangle { horizontal-stretch: 1; }
                                ToolButton { text: @tr("Close"); clicked => { root.settings-page = 0; } }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.dialog != 0 : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;
        TouchArea {}
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 460px;
                    background: Theme.panel;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: root.dialog-title; font-size: 16px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                        if root.dialog-body != "" : Text { text: root.dialog-body; font-size: 13px; color: Theme.text-dim; wrap: word-wrap; }
                        if root.dialog == 2 : VerticalLayout {
                            spacing: 8px;
                            Field { label: @tr("Name"); LineEdit { text: root.dlg-name; edited(v) => { root.dlg-name = v; } } }
                            Field { label: @tr("Date"); LineEdit { text: root.dlg-date; edited(v) => { root.dlg-date = v; } } }
                            HorizontalLayout {
                                spacing: 8px;
                                Field { label: @tr("Start"); LineEdit { text: root.dlg-start; edited(v) => { root.dlg-start = v; } } }
                                Field { label: @tr("End"); LineEdit { text: root.dlg-end; edited(v) => { root.dlg-end = v; } } }
                            }
                            Field { label: @tr("Image interval (minutes)"); SpinBox { minimum: 0; maximum: 180; value: root.dlg-interval; edited(v) => { root.dlg-interval = v; root.set-num("dlg-interval", v); } } }
                        }
                        if root.dialog == 3 : Field { label: @tr("Also keep empty days until"); LineEdit { text: root.dlg-horizon; edited(v) => { root.dlg-horizon = v; } } }
                        if root.dialog == 4 : VerticalLayout {
                            spacing: 8px;
                            Field { label: @tr("From"); LineEdit { text: root.exp-from; edited(v) => { root.exp-from = v; } } }
                            Field { label: @tr("To"); LineEdit { text: root.exp-to; edited(v) => { root.exp-to = v; } } }
                            Field {
                                label: @tr("Shape");
                                ComboBox {
                                    model: [@tr("Whole file"), @tr("Each transmission and each silence"), @tr("Each piece"), @tr("Slices"), @tr("One file per block")];
                                    current-index: root.exp-shape;
                                    selected => { root.exp-shape = self.current-index; }
                                }
                            }
                            Field { label: @tr("Seconds per slice"); SpinBox { minimum: 1; maximum: 7200; value: root.exp-slice; edited(v) => { root.exp-slice = v; } } }
                            Field {
                                label: @tr("Sample rate");
                                ComboBox {
                                    model: ["11025", "22050", "44100", "48000"];
                                    current-index: root.exp-rate;
                                    selected => { root.exp-rate = self.current-index; }
                                }
                            }
                            Text { text: root.exp-note; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if root.dialog-ok != "" : ToolButton { text: root.dialog-ok; primary: true; clicked => { root.confirm(0); } }
                            if root.dialog-alt != "" : ToolButton { text: root.dialog-alt; clicked => { root.confirm(1); } }
                            if root.dialog-extra != "" : ToolButton { text: root.dialog-extra; clicked => { root.confirm(2); } }
                        }
                    }
                }
            }
        }
    }
}
