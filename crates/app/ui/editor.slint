import { ComboBox, CheckBox, LineEdit, SpinBox, Slider, TextEdit, ScrollView, ListView, Palette } from "std-widgets.slint";
import { Theme, ToolButton, Field, PanelTitle, ColorField, Icon, Panel } from "theme.slint";
import { FileDrop, Files } from "files.slint";
import { LayerItem } from "types.slint";

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    padding-bottom: 6px;
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    PanelTitle {
        text: root.title;
    }
    @children
}

component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> current;
    callback chosen(int);
    spacing: 2px;
    for o[i] in root.options : ToolButton {
        text: o;
        horizontal-stretch: 1;
        active: i == root.current;
        clicked => { root.chosen(i); }
    }
}

component NumberField inherits Field {
    in property <int> value;
    in property <int> minimum: -10000;
    in property <int> maximum: 10000;
    callback edited(int);
    SpinBox {
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        edited(v) => { root.edited(v); }
    }
}

export component EditorWindow inherits Window {
    title: @tr("Channel graphics — {}", root.mode-name);
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 640px;
    background: Theme.bg;

    in property <image> frame;
    in property <int> canvas-w: 320;
    in property <int> canvas-h: 256;
    in property <string> mode-name;
    // Canvas order: bottom → top.
    in property <[LayerItem]> layers;
    // -1 = the program picture (base).
    in property <int> selected: -1;
    // The selected layer, as a 0/1-element model (recreated on selection change).
    in property <[LayerItem]> current;
    in property <[string]> fonts;
    in property <[string]> program-names;
    in property <int> preview-index;
    in property <int> fit-index;
    in property <color> background-color;
    in property <string> background-hex;
    in property <string> api-result;
    // Display labels for the "insert data" menu and the tokens they insert.
    in property <[string]> placeholders;
    in property <[string]> placeholder-tokens;
    // Snap guides while dragging (fractions of the canvas, -1 = none).
    in property <float> guide-x: -1;
    in property <float> guide-y: -1;

    callback add-text();
    callback add-image();
    callback add-qr();
    callback select(int);
    callback toggle-visible(int);
    callback move-layer(int);
    callback duplicate();
    callback remove();
    callback preview-selected(int);
    callback fit-selected(int);
    callback background-changed(string);
    callback canvas-press(float, float, float, float);
    callback canvas-drag(float, float);
    callback canvas-release();
    callback nudge(int, int);
    callback set-str(string, string);
    callback set-num(string, float);
    callback set-bool(string, bool);
    callback pick-image();
    callback drop-image([string]);
    callback api-test();
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Toolbar
        HorizontalLayout {
            height: 34px;
            spacing: 6px;
            ToolButton {
                icon: "text";
                text: @tr("Text");
                clicked => { root.add-text(); }
            }
            ToolButton {
                icon: "image";
                text: @tr("PNG image");
                clicked => { root.add-image(); }
            }
            ToolButton {
                icon: "qr";
                text: @tr("QR");
                clicked => { root.add-qr(); }
            }
            Rectangle {
                width: 1px;
                background: Theme.border;
            }
            ToolButton {
                icon: "up";
                text: @tr("Bring forward");
                enabled: root.selected >= 0 && root.selected < root.layers.length - 1;
                clicked => { root.move-layer(1); }
            }
            ToolButton {
                icon: "down";
                text: @tr("Send back");
                enabled: root.selected > 0;
                clicked => { root.move-layer(-1); }
            }
            ToolButton {
                icon: "copy";
                text: @tr("Duplicate");
                enabled: root.selected >= 0;
                clicked => { root.duplicate(); }
            }
            ToolButton {
                icon: "trash";
                text: @tr("Delete");
                enabled: root.selected >= 0;
                clicked => { root.remove(); }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Preview with program");
                    font-size: 12px;
                    color: Theme.text-dim;
                }
            }
            ComboBox {
                width: 240px;
                model: root.program-names;
                current-index: root.preview-index;
                selected => { root.preview-selected(self.current-index); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // Layers
            Panel {
                width: 250px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    PanelTitle {
                        text: @tr("LAYERS");
                        height: 20px;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for l[i] in root.layers : Rectangle {
                            // Listed top-most first.
                            property <int> idx: root.layers.length - 1 - i;
                            property <LayerItem> item: root.layers[self.idx];
                            height: 40px;
                            border-radius: 5px;
                            background: self.idx == root.selected ? Theme.accent.transparentize(0.75) : row-ta.has-hover ? Theme.panel-raised : transparent;
                            row-ta := TouchArea {
                                clicked => { root.select(parent.idx); }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;
                                Rectangle {
                                    width: 26px;
                                    Icon {
                                        name: item.visible ? "eye" : "eye-off";
                                        fill: item.visible ? Theme.text-dim : Theme.text-faint;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-visible(idx); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: item.is-qr ? "qr" : item.is-text ? "text" : "image";
                                        fill: Theme.text-faint;
                                    }
                                }
                                Text {
                                    text: item.name;
                                    font-size: 13px;
                                    color: item.visible ? Theme.text : Theme.text-faint;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    // The program picture is always the bottom layer.
                    Rectangle {
                        height: 44px;
                        border-radius: 5px;
                        background: root.selected == -1 ? Theme.accent.transparentize(0.75) : base-ta.has-hover ? Theme.panel-raised : Theme.field;
                        border-width: 1px;
                        border-color: Theme.border;
                        base-ta := TouchArea {
                            clicked => { root.select(-1); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: "image";
                                    fill: Theme.text-dim;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("Base picture");
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                                Text {
                                    text: @tr("the program that goes on air");
                                    font-size: 11px;
                                    color: Theme.text-faint;
                                }
                            }
                        }
                    }
                }
            }

            // Canvas
            canvas := Rectangle {
                horizontal-stretch: 1;
                background: #07090c;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                property <float> scale: min((self.width - 48px) / (root.canvas-w * 1px), (self.height - 64px) / (root.canvas-h * 1px));
                property <length> iw: root.canvas-w * 1px * self.scale;
                property <length> ih: root.canvas-h * 1px * self.scale;
                property <length> ix: (self.width - self.iw) / 2;
                property <length> iy: (self.height - 20px - self.ih) / 2;

                Image {
                    x: canvas.ix;
                    y: canvas.iy;
                    width: canvas.iw;
                    height: canvas.ih;
                    source: root.frame;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
                Rectangle {
                    x: canvas.ix - 1px;
                    y: canvas.iy - 1px;
                    width: canvas.iw + 2px;
                    height: canvas.ih + 2px;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                }
                for l[i] in root.layers : Rectangle {
                    x: canvas.ix + l.x * canvas.iw;
                    y: canvas.iy + l.y * canvas.ih;
                    width: l.w * canvas.iw;
                    height: l.h * canvas.ih;
                    border-width: i == root.selected ? 2px : 1px;
                    border-color: i == root.selected ? Theme.accent : l.visible ? #ffffff28 : transparent;
                }
                if root.guide-x >= 0 : Rectangle {
                    x: canvas.ix + root.guide-x * canvas.iw;
                    y: canvas.iy;
                    width: 1px;
                    height: canvas.ih;
                    background: #ff4fd8;
                }
                if root.guide-y >= 0 : Rectangle {
                    x: canvas.ix;
                    y: canvas.iy + root.guide-y * canvas.ih;
                    width: canvas.iw;
                    height: 1px;
                    background: #ff4fd8;
                }
                if root.selected >= 0 && root.selected < root.layers.length : Rectangle {
                    property <LayerItem> s: root.layers[root.selected];
                    x: canvas.ix + self.s.x * canvas.iw;
                    y: canvas.iy + self.s.y * canvas.ih;
                    width: self.s.w * canvas.iw;
                    height: self.s.h * canvas.ih;
                    for c in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 }] : Rectangle {
                        x: parent.width * c.x - 5px;
                        y: parent.height * c.y - 5px;
                        width: 10px;
                        height: 10px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: Theme.accent;
                        border-radius: 2px;
                    }
                }
                Text {
                    x: canvas.ix;
                    y: canvas.iy + canvas.ih + 8px;
                    text: @tr("{} × {} px · {} · drag to move, corners to resize, arrows to nudge", root.canvas-w, root.canvas-h, root.mode-name);
                    font-size: 11px;
                    color: Theme.text-faint;
                }
                keys := FocusScope {
                    key-pressed(e) => {
                        if (e.text == Key.LeftArrow) { root.nudge(e.modifiers.shift ? -10 : -1, 0); return accept; }
                        if (e.text == Key.RightArrow) { root.nudge(e.modifiers.shift ? 10 : 1, 0); return accept; }
                        if (e.text == Key.UpArrow) { root.nudge(0, e.modifiers.shift ? -10 : -1); return accept; }
                        if (e.text == Key.DownArrow) { root.nudge(0, e.modifiers.shift ? 10 : 1); return accept; }
                        if (e.text == Key.Delete) { root.remove(); return accept; }
                        reject
                    }
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                keys.focus();
                                root.canvas-press((self.mouse-x - canvas.ix) / canvas.iw, (self.mouse-y - canvas.iy) / canvas.ih, 9px / canvas.iw, 9px / canvas.ih);
                            } else if (e.kind == PointerEventKind.up) {
                                root.canvas-release();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.canvas-drag((self.mouse-x - canvas.ix) / canvas.iw, (self.mouse-y - canvas.iy) / canvas.ih);
                            }
                        }
                    }
                }
            }

            // Inspector
            Panel {
                width: 330px;
                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        alignment: start;

                        if root.selected == -1 : VerticalLayout {
                            spacing: 10px;
                            PanelTitle {
                                text: @tr("BASE PICTURE");
                            }
                            Text {
                                text: @tr("This is each program's picture. It always stays at the bottom and is fitted to the mode size.");
                                font-size: 12px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                            Field {
                                label: @tr("How it is fitted");
                                ComboBox {
                                    model: [@tr("Crop to fill"), @tr("Fit (with bars)"), @tr("Stretch")];
                                    current-index: root.fit-index;
                                    selected => { root.fit-selected(self.current-index); }
                                }
                            }
                            Field {
                                label: @tr("Background color (bars)");
                                ColorField {
                                    value: root.background-color;
                                    hex: root.background-hex;
                                    changed(h) => { root.background-changed(h); }
                                }
                            }
                        }

                        for cur in root.current : VerticalLayout {
                            spacing: 10px;
                            PanelTitle {
                                text: cur.is-qr ? "QR" : cur.is-text ? "TEXTO" : "IMAGEN";
                            }
                            Field {
                                label: @tr("Layer name");
                                LineEdit {
                                    text: cur.name;
                                    edited(v) => { root.set-str("name", v); }
                                }
                            }

                            if cur.is-text : VerticalLayout {
                                spacing: 10px;
                                Field {
                                    label: @tr("Text (can include fields in braces)");
                                    text-edit := TextEdit {
                                        height: 74px;
                                        text: cur.text;
                                        wrap: word-wrap;
                                        edited(v) => { root.set-str("text", v); }
                                    }
                                }
                                ComboBox {
                                    model: root.placeholders;
                                    current-index: 0;
                                    selected => {
                                        if (self.current-index > 0) {
                                            text-edit.text += root.placeholder-tokens[self.current-index];
                                            root.set-str("text", text-edit.text);
                                            self.current-index = 0;
                                        }
                                    }
                                }
                                CheckBox {
                                    text: @tr("Data from a web API → {{api}}");
                                    checked: cur.api-on;
                                    toggled => { root.set-bool("api", self.checked); }
                                }
                                if cur.api-on : VerticalLayout {
                                    spacing: 8px;
                                    Field {
                                        label: "URL";
                                        LineEdit {
                                            text: cur.api-url;
                                            placeholder-text: "https://…";
                                            edited(v) => { root.set-str("api-url", v); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field {
                                            label: @tr("JSON field (empty = all)");
                                            horizontal-stretch: 2;
                                            LineEdit {
                                                text: cur.api-path;
                                                placeholder-text: "current.temperature_2m";
                                                edited(v) => { root.set-str("api-path", v); }
                                            }
                                        }
                                        NumberField {
                                            label: @tr("Every (s)");
                                            minimum: 10;
                                            maximum: 86400;
                                            value: cur.api-refresh;
                                            edited(v) => { root.set-num("api-refresh", v); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ToolButton {
                                            text: @tr("Test");
                                            clicked => { root.api-test(); }
                                        }
                                        Text {
                                            text: root.api-result;
                                            font-size: 12px;
                                            color: Theme.text-dim;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                Section {
                                    title: @tr("TYPE");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ComboBox {
                                            horizontal-stretch: 1;
                                            model: root.fonts;
                                            current-index: cur.font-index;
                                            selected => { root.set-str("font", self.current-value); }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            CheckBox {
                                                text: @tr("Bold");
                                                checked: cur.bold;
                                                toggled => { root.set-bool("bold", self.checked); }
                                            }
                                        }
                                    }
                                    Field {
                                        label: @tr("Size: {} % of height", round(cur.size * 100));
                                        Slider {
                                            minimum: 3;
                                            maximum: 40;
                                            value: cur.size * 100;
                                            changed(v) => { root.set-num("size", v / 100); }
                                        }
                                    }
                                    Field {
                                        label: @tr("Color");
                                        ColorField {
                                            value: cur.color;
                                            hex: cur.color-hex;
                                            changed(h) => { root.set-str("color", h); }
                                        }
                                    }
                                    Field {
                                        label: @tr("Alignment");
                                        Segmented {
                                            options: [@tr("Left"), @tr("Center"), @tr("Right")];
                                            current: cur.align;
                                            chosen(i) => { root.set-num("align", i); }
                                        }
                                    }
                                    Segmented {
                                        options: [@tr("Top"), @tr("Middle"), @tr("Bottom")];
                                        current: cur.valign;
                                        chosen(i) => { root.set-num("valign", i); }
                                    }
                                    CheckBox {
                                        text: @tr("Shrink the type if it does not fit the box");
                                        checked: cur.shrink;
                                        toggled => { root.set-bool("shrink", self.checked); }
                                    }
                                }
                                Section {
                                    title: @tr("ON-AIR READABILITY");
                                    Field {
                                        label: @tr("Outline: {} %", round(cur.outline * 100));
                                        Slider {
                                            minimum: 0;
                                            maximum: 30;
                                            value: cur.outline * 100;
                                            changed(v) => { root.set-num("outline", v / 100); }
                                        }
                                    }
                                    if cur.outline > 0 : ColorField {
                                        value: cur.outline-color;
                                        hex: cur.outline-hex;
                                        changed(h) => { root.set-str("outline-color", h); }
                                    }
                                    CheckBox {
                                        text: @tr("Shadow");
                                        checked: cur.shadow;
                                        toggled => { root.set-bool("shadow", self.checked); }
                                    }
                                    Field {
                                        label: @tr("Background box (transparent = none)");
                                        ColorField {
                                            value: cur.box-color;
                                            hex: cur.box-hex;
                                            changed(h) => { root.set-str("box-color", h); }
                                        }
                                    }
                                }
                            }

                            if cur.is-qr : VerticalLayout {
                                spacing: 10px;
                                Field {
                                    label: @tr("Source");
                                    ComboBox {
                                        model: [@tr("Text"), @tr("Command"), @tr("API")];
                                        current-index: cur.qr-source;
                                        selected => { root.set-num("qr-source", self.current-index); }
                                    }
                                }
                                Field {
                                    label: @tr("Error correction");
                                    ComboBox {
                                        model: ["L", "M", "Q", "H"];
                                        current-index: cur.qr-ecc;
                                        selected => { root.set-num("qr-ecc", self.current-index); }
                                    }
                                }
                                if cur.qr-source == 0 : Field {
                                    label: @tr("Text (can include fields in braces)");
                                    LineEdit {
                                        text: cur.qr-text;
                                        edited(v) => { root.set-str("qr-text", v); }
                                    }
                                }
                                if cur.qr-source == 1 : Field {
                                    label: @tr("Command (the line is expanded, not its output)");
                                    LineEdit {
                                        text: cur.qr-command;
                                        edited(v) => { root.set-str("qr-command", v); }
                                    }
                                }
                                if cur.qr-source == 2 : VerticalLayout {
                                    spacing: 8px;
                                    Field {
                                        label: @tr("URL");
                                        LineEdit {
                                            text: cur.api-url;
                                            edited(v) => { root.set-str("qr-api-url", v); }
                                        }
                                    }
                                    Field {
                                        label: @tr("JSON path (empty = raw body)");
                                        LineEdit {
                                            text: cur.api-path;
                                            edited(v) => { root.set-str("qr-api-path", v); }
                                        }
                                    }
                                }
                                if cur.qr-warn != "" : Text {
                                    text: cur.qr-warn;
                                    font-size: 12px;
                                    color: Theme.paused;
                                    wrap: word-wrap;
                                }
                            }

                            if !cur.is-text && !cur.is-qr : VerticalLayout {
                                spacing: 10px;
                                    Field {
                                        label: @tr("File");
                                        FileDrop {
                                            compact: true;
                                            title: cur.image-path == "" ? @tr("Drop or pick the picture") : cur.image-path;
                                            path: cur.image-path;
                                            dropped(paths) => { root.drop-image(paths); }
                                            browse => { root.pick-image(); }
                                        }
                                    }
                                CheckBox {
                                    text: @tr("Keep aspect ratio");
                                    checked: cur.keep-aspect;
                                    toggled => { root.set-bool("keep-aspect", self.checked); }
                                }
                            }

                            Section {
                                title: @tr("POSITION AND SIZE (px)");
                                HorizontalLayout {
                                    spacing: 8px;
                                    NumberField {
                                        label: "X";
                                        value: round(cur.x * root.canvas-w);
                                        edited(v) => { root.set-num("x", v); }
                                    }
                                    NumberField {
                                        label: "Y";
                                        value: round(cur.y * root.canvas-h);
                                        edited(v) => { root.set-num("y", v); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    NumberField {
                                        label: @tr("Width");
                                        minimum: 1;
                                        value: round(cur.w * root.canvas-w);
                                        edited(v) => { root.set-num("w", v); }
                                    }
                                    NumberField {
                                        label: @tr("Height");
                                        minimum: 1;
                                        value: round(cur.h * root.canvas-h);
                                        edited(v) => { root.set-num("h", v); }
                                    }
                                }
                                Field {
                                    label: @tr("Opacity: {} %", round(cur.opacity * 100));
                                    Slider {
                                        minimum: 0;
                                        maximum: 100;
                                        value: cur.opacity * 100;
                                        changed(v) => { root.set-num("opacity", v / 100); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Text {
            text: @tr("Changes apply immediately and are saved with the project (Save in the main window).");
            font-size: 11px;
            color: Theme.text-faint;
        }
    }
}
