import { ComboBox, CheckBox, LineEdit, SpinBox, Slider, TabWidget, ScrollView, Switch, Palette } from "std-widgets.slint";
import { Theme, ToolButton, Field, PanelTitle } from "theme.slint";
import { FileDrop, Files } from "files.slint";
import { TriggerItem, ImageItem } from "types.slint";

component DialogFooter inherits HorizontalLayout {
    in property <string> error;
    callback save();
    callback cancel();
    spacing: 8px;
    Text {
        text: root.error;
        color: Theme.danger;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    ToolButton {
        text: @tr("Cancel");
        clicked => { root.cancel(); }
    }
    ToolButton {
        text: @tr("Save");
        primary: true;
        clicked => { root.save(); }
    }
}

component DayToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> on;
    width: 38px;
    height: 32px;
    border-radius: 5px;
    background: root.on ? Theme.accent : Theme.panel-raised;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 700;
        color: root.on ? #ffffff : Theme.text-dim;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.on = !root.on; }
    }
}

component Hint inherits Text {
    font-size: 11px;
    color: Theme.text-faint;
    wrap: word-wrap;
}

// ───────────────────────── Grid block ─────────────────────────

export struct SlotForm {
    name: string,
    enabled: bool,
    d0: bool,
    d1: bool,
    d2: bool,
    d3: bool,
    d4: bool,
    d5: bool,
    d6: bool,
    start: string,
    end: string,
    repeat: bool,
    every: int,
    program: int,
    freq: string,
}

export component SlotDialog inherits Window {
    title: @tr("Grid block");
    icon: @image-url("../assets/icon.png");
    width: 520px;
    height: 560px;
    background: Theme.bg;
   
    in property <SlotForm> form;
    in property <[string]> program-names;
    in property <string> tz-name: "UTC";
    in property <string> error;
    callback save(SlotForm);
    callback cancel();
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    property <bool> repeat: root.form.repeat;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        Field {
            label: @tr("Block name");
            name-edit := LineEdit {
                text: root.form.name;
                placeholder-text: @tr("e.g. Night on 80 m");
            }
        }
        Field {
            label: @tr("Days");
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                d0 := DayToggle { label: @tr("Mo"); on: root.form.d0; }
                d1 := DayToggle { label: @tr("Tu"); on: root.form.d1; }
                d2 := DayToggle { label: @tr("We"); on: root.form.d2; }
                d3 := DayToggle { label: @tr("Th"); on: root.form.d3; }
                d4 := DayToggle { label: @tr("Fr"); on: root.form.d4; }
                d5 := DayToggle { label: @tr("Sa"); on: root.form.d5; }
                d6 := DayToggle { label: @tr("Su"); on: root.form.d6; }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Field {
                label: @tr("Starts ({})", root.tz-name);
                start-edit := LineEdit {
                    text: root.form.start;
                    placeholder-text: "HH:MM";
                }
            }
            Field {
                label: @tr("Repeat");
                HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        repeat-switch := Switch {
                            checked: root.form.repeat;
                            toggled => { root.repeat = self.checked; }
                        }
                    }
                }
            }
        }
        if root.repeat : HorizontalLayout {
            spacing: 12px;
            Field {
                label: @tr("Every (minutes)");
                every-spin := SpinBox {
                    minimum: 1;
                    maximum: 1440;
                    value: root.form.every;
                    edited(v) => { root.every-value = v; }
                }
            }
            Field {
                label: @tr("Until ({})", root.tz-name);
                end-edit := LineEdit {
                    text: root.form.end;
                    placeholder-text: "HH:MM";
                    edited(t) => { root.end-value = t; }
                }
            }
        }
        if root.repeat : Hint {
            text: @tr("If Until is earlier than the start, the block ends the next day. If a transmission lasts longer than the interval, the next one waits for the minimum pause.");
        }
        Field {
            label: @tr("What goes on air");
            program-box := ComboBox {
                model: root.program-names;
                current-index: root.form.program;
            }
        }
        Field {
            label: @tr("Frequency (MHz, optional — set via CAT if enabled)");
            freq-edit := LineEdit {
                text: root.form.freq;
                placeholder-text: @tr("e.g. 14.230");
            }
        }
        HorizontalLayout {
            alignment: start;
            enabled-box := CheckBox {
                text: @tr("Block enabled");
                checked: root.form.enabled;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => {
                root.save({
                    name: name-edit.text,
                    enabled: enabled-box.checked,
                    d0: d0.on, d1: d1.on, d2: d2.on, d3: d3.on, d4: d4.on, d5: d5.on, d6: d6.on,
                    start: start-edit.text,
                    end: root.end-value,
                    repeat: root.repeat,
                    every: root.every-value,
                    program: program-box.current-index,
                    freq: freq-edit.text,
                });
            }
        }
    }
    // The repeat fields live inside an `if`, so their values are mirrored here.
    property <int> every-value: root.form.every;
    property <string> end-value: root.form.end;
}

// ───────────────────────── Project ─────────────────────────

export struct ProjectForm {
    name: string,
    call: string,
    operator: string,
    qth: string,
    locator: string,
    color-range: int,
    vox: bool,
    fsk: bool,
    cw-preamble: bool,
    cw: bool,
    cw-text: string,
    cw-wpm: int,
    cw-tone: int,
    pause: int,
    offset-min: int,
    offset-sec: int,
    listen-cw: bool,
    listen-wpm: int,
    listen-tone: int,
    listen-dtmf: bool,
}

export component ProjectDialog inherits Window {
    title: @tr("Project");
    icon: @image-url("../assets/icon.png");
    width: 640px;
    height: 640px;
    background: Theme.bg;
   
    in property <ProjectForm> form;
    in property <[TriggerItem]> triggers;
    in property <[string]> program-names;
    in property <string> error;
    callback save(ProjectForm);
    callback cancel();
    callback trigger-add();
    callback trigger-remove(int);
    callback trigger-edit(int, TriggerItem);
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: @tr("Station");
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: @tr("Channel / project name");
                        name-edit := LineEdit { text: root.form.name; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: @tr("Callsign");
                            call-edit := LineEdit { text: root.form.call; placeholder-text: "LU1ABC"; }
                        }
                        Field {
                            label: @tr("Operator");
                            op-edit := LineEdit { text: root.form.operator; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "QTH";
                            qth-edit := LineEdit { text: root.form.qth; }
                        }
                        Field {
                            label: "Locator";
                            loc-edit := LineEdit { text: root.form.locator; placeholder-text: "FF78"; }
                        }
                    }
                    Hint {
                        text: @tr("These fields can appear on the graphics as {{call}}, {{op}}, {{qth}} and {{loc}}. SSTV mode is chosen in the main bar and is also saved with the project.");
                    }
                }
            }
            Tab {
                title: @tr("Transmission");
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: @tr("Minimum pause between transmissions (seconds) — protects the radio");
                        pause-spin := SpinBox { minimum: 0; maximum: 3600; value: root.form.pause; }
                    }
                    Field {
                        label: @tr("Grid delay — every TX starts this long after the block time");
                        HorizontalLayout {
                            spacing: 8px;
                            offset-min-spin := SpinBox { minimum: 0; maximum: 180; value: root.form.offset-min; }
                            Text { text: @tr("min"); vertical-alignment: center; color: Theme.text-dim; }
                            offset-sec-spin := SpinBox { minimum: 0; maximum: 59; value: root.form.offset-sec; }
                            Text { text: @tr("s"); vertical-alignment: center; color: Theme.text-dim; }
                        }
                    }
                    Hint {
                        text: @tr("Blocks are written on the hour (14:00). The delay lets several channels share a frequency: if another occupies 14:00–14:03, set 3 min and yours start at 14:03.");
                    }
                    Field {
                        label: @tr("Robot / PD color range");
                        range-box := ComboBox {
                            model: [@tr("Full 0–255 (QSSTV, slowrx; recommended)"), @tr("Studio BT.601 16–235")];
                            current-index: root.form.color-range;
                        }
                    }
                    vox-box := CheckBox {
                        text: @tr("Preamble tones before VIS (open VOX)");
                        checked: root.form.vox;
                    }
                    fsk-box := CheckBox {
                        text: @tr("FSK ID at the end (callsign readable by MMSSTV)");
                        checked: root.form.fsk;
                    }
                    cw-pre-box := CheckBox {
                        text: @tr("CW identification before VIS (preamble)");
                        checked: root.form.cw-preamble;
                    }
                    cw-box := CheckBox {
                        text: @tr("CW identification at the end of each transmission");
                        checked: root.form.cw;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: @tr("CW text");
                            horizontal-stretch: 2;
                            cw-text-edit := LineEdit { text: root.form.cw-text; }
                        }
                        Field {
                            label: @tr("Speed (wpm)");
                            cw-wpm-spin := SpinBox { minimum: 5; maximum: 50; value: root.form.cw-wpm; }
                        }
                        Field {
                            label: @tr("Tone (Hz)");
                            cw-tone-spin := SpinBox { minimum: 300; maximum: 2500; step-size: 50; value: root.form.cw-tone; }
                        }
                    }
                    Hint {
                        text: @tr("The preamble comes after the VOX tones and before VIS. The post comes after the picture (and FSK ID if enabled). The text accepts {{call}}.");
                    }
                }
            }
            Tab {
                title: @tr("Listen and triggers");
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            listen-cw-box := CheckBox { text: @tr("Decode CW"); checked: root.form.listen-cw; }
                        }
                        Field {
                            label: @tr("Fixed speed (wpm)");
                            listen-wpm-spin := SpinBox { minimum: 5; maximum: 50; value: root.form.listen-wpm; }
                        }
                        Field {
                            label: @tr("Tone (Hz)");
                            listen-tone-spin := SpinBox { minimum: 300; maximum: 2500; step-size: 10; value: root.form.listen-tone; }
                        }
                    }
                    listen-dtmf-box := CheckBox { text: @tr("Decode DTMF"); checked: root.form.listen-dtmf; }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        PanelTitle { text: @tr("TRIGGERS"); horizontal-stretch: 1; }
                        ToolButton {
                            icon: "plus";
                            text: @tr("Add");
                            clicked => { root.trigger-add(); }
                        }
                    }
                    Hint {
                        text: @tr("DTMF: the sequence ends with # or after 2.5 s of silence (e.g. *12#). CW: fires when received text ends with those words (e.g. QRV SSTV).");
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            for t[i] in root.triggers : HorizontalLayout {
                                spacing: 8px;
                                height: 34px;
                                VerticalLayout {
                                    alignment: center;
                                    CheckBox {
                                        checked: t.enabled;
                                        toggled => { root.trigger-edit(i, { enabled: self.checked, source: t.source, code: t.code, action: t.action, program: t.program }); }
                                    }
                                }
                                ComboBox {
                                    width: 90px;
                                    model: ["DTMF", "CW"];
                                    current-index: t.source;
                                    selected => { root.trigger-edit(i, { enabled: t.enabled, source: self.current-index, code: t.code, action: t.action, program: t.program }); }
                                }
                                LineEdit {
                                    width: 120px;
                                    text: t.code;
                                    placeholder-text: "*12#";
                                    edited(v) => { root.trigger-edit(i, { enabled: t.enabled, source: t.source, code: v, action: t.action, program: t.program }); }
                                }
                                ComboBox {
                                    width: 130px;
                                    model: [@tr("Transmit"), @tr("Pause grid"), @tr("Resume grid")];
                                    current-index: t.action;
                                    selected => { root.trigger-edit(i, { enabled: t.enabled, source: t.source, code: t.code, action: self.current-index, program: t.program }); }
                                }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    enabled: t.action == 0;
                                    model: root.program-names;
                                    current-index: t.program;
                                    selected => { root.trigger-edit(i, { enabled: t.enabled, source: t.source, code: t.code, action: t.action, program: self.current-index }); }
                                }
                                ToolButton {
                                    icon: "trash";
                                    clicked => { root.trigger-remove(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => {
                root.save({
                    name: name-edit.text,
                    call: call-edit.text,
                    operator: op-edit.text,
                    qth: qth-edit.text,
                    locator: loc-edit.text,
                    color-range: range-box.current-index,
                    vox: vox-box.checked,
                    fsk: fsk-box.checked,
                    cw-preamble: cw-pre-box.checked,
                    cw: cw-box.checked,
                    cw-text: cw-text-edit.text,
                    cw-wpm: cw-wpm-spin.value,
                    cw-tone: cw-tone-spin.value,
                    pause: pause-spin.value,
                    offset-min: offset-min-spin.value,
                    offset-sec: offset-sec-spin.value,
                    listen-cw: listen-cw-box.checked,
                    listen-wpm: listen-wpm-spin.value,
                    listen-tone: listen-tone-spin.value,
                    listen-dtmf: listen-dtmf-box.checked,
                });
            }
        }
    }
}

// ───────────────────────── Station hardware ─────────────────────────

export struct ConfigForm {
    out-index: int,
    in-index: int,
    rate-index: int,
    channel: int,
    level: float,
    ppm: string,
    ptt-method: int,
    port-index: int,
    port-manual: string,
    line: int,
    invert: bool,
    lead: int,
    tail: int,
    timeout: int,
    cat-host: string,
    cat-port: int,
    cat-freq: bool,
    autostart: bool,
    gpu: bool,
    light: bool,
    lang: int,
}

export component ConfigDialog inherits Window {
    title: @tr("Equipment: audio, PTT and CAT");
    icon: @image-url("../assets/icon.png");
    width: 640px;
    height: 660px;
    background: Theme.bg;
   
    in property <ConfigForm> form;
    in property <[string]> out-devices;
    in property <[string]> in-devices;
    in property <[string]> ports;
    in property <string> config-path;
    in property <string> error;
    in property <string> test-state;
    callback save(ConfigForm);
    callback cancel();
    callback test-tone(ConfigForm);
    callback test-ptt(ConfigForm);
    callback refresh();
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    property <int> method: root.form.ptt-method;

    function current() -> ConfigForm {
        return {
            out-index: out-box.current-index,
            in-index: in-box.current-index,
            rate-index: rate-box.current-index,
            channel: channel-box.current-index,
            level: level-slider.value,
            ppm: ppm-edit.text,
            ptt-method: root.method,
            port-index: root.port-index,
            port-manual: root.port-manual,
            line: root.line,
            invert: root.invert,
            lead: lead-spin.value,
            tail: tail-spin.value,
            timeout: timeout-spin.value,
            cat-host: root.cat-host,
            cat-port: root.cat-port,
            cat-freq: root.cat-freq,
            autostart: autostart-box.checked,
            gpu: gpu-box.checked,
            light: light-box.checked,
            lang: lang-box.current-index,
        };
    }

    // Fields shown conditionally are mirrored in properties so they survive toggling.
    property <int> port-index: root.form.port-index;
    property <string> port-manual: root.form.port-manual;
    property <int> line: root.form.line;
    property <bool> invert: root.form.invert;
    property <string> cat-host: root.form.cat-host;
    property <int> cat-port: root.form.cat-port;
    property <bool> cat-freq: root.form.cat-freq;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: @tr("Audio");
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: @tr("Output (to the transmitter)");
                        out-box := ComboBox { model: root.out-devices; current-index: root.form.out-index; }
                    }
                    Field {
                        label: @tr("Input (from the receiver, for CW / DTMF)");
                        in-box := ComboBox { model: root.in-devices; current-index: root.form.in-index; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: @tr("Sample rate");
                            rate-box := ComboBox {
                                model: [@tr("Device default"), "8000 Hz", "11025 Hz", "22050 Hz", "44100 Hz", "48000 Hz"];
                                current-index: root.form.rate-index;
                            }
                        }
                        Field {
                            label: @tr("Output channel");
                            channel-box := ComboBox {
                                model: [@tr("Both"), @tr("Left"), @tr("Right")];
                                current-index: root.form.channel;
                            }
                        }
                    }
                    Field {
                        label: @tr("Output level: {} %", round(level-slider.value));
                        level-slider := Slider { minimum: 0; maximum: 100; value: root.form.level; }
                    }
                    Field {
                        label: @tr("Sound-card clock correction (ppm) — if pictures come out slanted");
                        ppm-edit := LineEdit { text: root.form.ppm; placeholder-text: "0"; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        ToolButton {
                            icon: "wave";
                            text: @tr("Test tone 5 s (with PTT)");
                            clicked => { root.test-tone(root.current()); }
                        }
                        ToolButton {
                            text: @tr("Rescan devices");
                            clicked => { root.refresh(); }
                        }
                    }
                    Hint {
                        text: @tr("With the test tone, raise the level until the radio ALC just starts to move.");
                    }
                }
            }
            Tab {
                title: @tr("PTT and CAT");
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: @tr("How the radio is keyed");
                        method-box := ComboBox {
                            model: [@tr("None (audio only)"), @tr("Radio VOX"), @tr("Serial port (RTS / DTR)"), @tr("CAT via Hamlib (rigctld)")];
                            current-index: root.method;
                            selected => { root.method = self.current-index; }
                        }
                    }
                    if root.method == 2 : VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: @tr("Detected port");
                                ComboBox {
                                    model: root.ports;
                                    current-index: root.port-index;
                                    selected => { root.port-index = self.current-index; }
                                }
                            }
                            Field {
                                label: @tr("or another (e.g. COM7, /dev/ttyACM0)");
                                LineEdit {
                                    text: root.port-manual;
                                    edited(t) => { root.port-manual = t; }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: @tr("Line");
                                ComboBox {
                                    model: ["RTS", "DTR", @tr("RTS and DTR")];
                                    current-index: root.line;
                                    selected => { root.line = self.current-index; }
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                CheckBox {
                                    text: @tr("Inverted (active low)");
                                    checked: root.invert;
                                    toggled => { root.invert = self.checked; }
                                }
                            }
                        }
                    }
                    if root.method == 3 : VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: @tr("rigctld host");
                                horizontal-stretch: 2;
                                LineEdit {
                                    text: root.cat-host;
                                    edited(t) => { root.cat-host = t; }
                                }
                            }
                            Field {
                                label: @tr("Port");
                                SpinBox {
                                    minimum: 1;
                                    maximum: 65535;
                                    value: root.cat-port;
                                    edited(v) => { root.cat-port = v; }
                                }
                            }
                        }
                        CheckBox {
                            text: @tr("Set each block frequency before transmitting");
                            checked: root.cat-freq;
                            toggled => { root.cat-freq = self.checked; }
                        }
                        Hint {
                            text: @tr("Example: rigctld -m <model> -r /dev/ttyUSB0 -s 38400. Hamlib supports hundreds of radios.");
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: @tr("Lead before audio (ms)");
                            lead-spin := SpinBox { minimum: 0; maximum: 5000; step-size: 50; value: root.form.lead; }
                        }
                        Field {
                            label: @tr("Tail after (ms)");
                            tail-spin := SpinBox { minimum: 0; maximum: 5000; step-size: 50; value: root.form.tail; }
                        }
                        Field {
                            label: @tr("Maximum time (s)");
                            timeout-spin := SpinBox { minimum: 30; maximum: 3600; step-size: 30; value: root.form.timeout; }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        ToolButton {
                            text: @tr("Test PTT (2 s)");
                            clicked => { root.test-ptt(root.current()); }
                        }
                    }
                }
            }
            Tab {
                title: @tr("General");
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    autostart-box := CheckBox {
                        text: @tr("Start with the grid on air (unattended stations)");
                        checked: root.form.autostart;
                    }
                    gpu-box := CheckBox {
                        text: @tr("Draw the UI with the GPU (OpenGL; uses more memory, requires restart)");
                        checked: root.form.gpu;
                    }
                    light-box := CheckBox {
                        text: @tr("Light theme");
                        checked: root.form.light;
                    }
                    Field {
                        label: @tr("Language");
                        lang-box := ComboBox {
                            model: ["English", "Español"];
                            current-index: root.form.lang;
                        }
                    }
                    Hint {
                        text: @tr("This configuration belongs to this PC (audio, port, PTT) and is saved apart from the project, in:\n{}", root.config-path);
                    }
                }
            }
        }
        if root.test-state != "" : Text {
            text: root.test-state;
            font-size: 12px;
            color: Theme.text-dim;
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => { root.save(root.current()); }
        }
    }
}

// ───────────────────────── Confirmation / message ─────────────────────────

export component ConfirmDialog inherits Window {
    title: "Estivi";
    icon: @image-url("../assets/icon.png");
    preferred-width: 460px;
    background: Theme.bg;
   
    in property <string> heading;
    in property <string> message;
    in property <string> primary: @tr("OK");
    // Empty = button hidden.
    in property <string> secondary;
    in property <string> cancel;
    // 0 primary, 1 secondary, 2 cancel
    callback chosen(int);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Text {
            text: root.heading;
            font-size: 16px;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.message;
            font-size: 13px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            padding-top: 6px;
            if root.cancel != "" : ToolButton {
                text: root.cancel;
                clicked => { root.chosen(2); }
            }
            if root.secondary != "" : ToolButton {
                text: root.secondary;
                clicked => { root.chosen(1); }
            }
            ToolButton {
                text: root.primary;
                primary: true;
                clicked => { root.chosen(0); }
            }
        }
    }
}

// ───────────────────────── Rename ─────────────────────────

export component RenameDialog inherits Window {
    title: @tr("Rename");
    icon: @image-url("../assets/icon.png");
    preferred-width: 420px;
    background: Theme.bg;
   
    in property <string> heading;
    in property <string> value;
    callback save(string);
    callback cancel();
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Field {
            label: root.heading;
            name-edit := LineEdit {
                text: root.value;
                accepted(t) => { root.save(t); }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            ToolButton {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            ToolButton {
                text: @tr("Save");
                primary: true;
                clicked => { root.save(name-edit.text); }
            }
        }
    }
    init => { name-edit.focus(); }
}

// ───────────────────────── Program (image group) ─────────────────────────

export struct ProgramForm {
    name: string,
    enabled: bool,
    rotation: int,
    inherit-cw: bool,
    cw-preamble: bool,
    cw: bool,
    cw-text: string,
    mode: int,
}

export component ProgramDialog inherits Window {
    title: @tr("Program");
    icon: @image-url("../assets/icon.png");
    width: 760px;
    height: 720px;
    background: Theme.bg;
   
    in property <ProgramForm> form;
    in property <[ImageItem]> images;
    in property <[TriggerItem]> activations;
    in property <[string]> mode-names;
    in property <[string]> image-modes;
    in property <string> error;
    callback save(ProgramForm);
    callback cancel();
    callback images-dropped([string]);
    callback pick-images();
    callback image-remove(int);
    callback image-move(int, int);
    callback image-toggle(int, bool);
    callback image-mode(int, int);
    callback activation-add();
    callback activation-remove(int);
    callback activation-edit(int, TriggerItem);
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    property <bool> inherit-cw: root.form.inherit-cw;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: @tr("Pictures");
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Field {
                        label: @tr("Program name");
                        name-edit := LineEdit {
                            text: root.form.name;
                            placeholder-text: @tr("e.g. Night on 80 m");
                        }
                    }
                    Field {
                        label: @tr("Picture order");
                        rot-box := ComboBox {
                            model: [@tr("In order"), @tr("Shuffle (no repeats)")];
                            current-index: root.form.rotation;
                        }
                    }
                    Field {
                        label: @tr("Program SSTV mode (default for its pictures)");
                        mode-box := ComboBox {
                            model: root.mode-names;
                            current-index: root.form.mode;
                        }
                    }
                    FileDrop {
                        compact: true;
                        title: @tr("Drop or pick pictures");
                        hint: "PNG, JPG, BMP o GIF. Varias a la vez.";
                        many: true;
                        dropped(paths) => { root.images-dropped(paths); }
                        browse => { root.pick-images(); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            for img[i] in root.images : HorizontalLayout {
                                spacing: 8px;
                                height: 48px;
                                Rectangle {
                                    width: 56px;
                                    background: #111111;
                                    Image {
                                        source: img.thumb;
                                        image-fit: contain;
                                        opacity: img.enabled ? 1.0 : 0.35;
                                    }
                                    if img.missing : Text {
                                        text: @tr("MISSING");
                                        font-size: 9px;
                                        color: #ffffff;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: img.name;
                                        font-size: 13px;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: img.path;
                                        font-size: 11px;
                                        color: Theme.text-faint;
                                        overflow: elide;
                                    }
                                }
                                ComboBox {
                                    width: 150px;
                                    model: root.image-modes;
                                    current-index: img.mode-index;
                                    selected => { root.image-mode(i, self.current-index); }
                                }
                                CheckBox {
                                    checked: img.enabled;
                                    toggled => { root.image-toggle(i, self.checked); }
                                }
                                ToolButton {
                                    icon: "up";
                                    enabled: i > 0;
                                    clicked => { root.image-move(i, -1); }
                                }
                                ToolButton {
                                    icon: "down";
                                    enabled: i < root.images.length - 1;
                                    clicked => { root.image-move(i, 1); }
                                }
                                ToolButton {
                                    icon: "trash";
                                    clicked => { root.image-remove(i); }
                                }
                            }
                        }
                    }
                    if root.images.length == 0 : Text {
                        text: @tr("A program is a group of pictures. Drop several or pick them with the button.");
                        font-size: 12px;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    enabled-box := CheckBox {
                        text: @tr("Program enabled");
                        checked: root.form.enabled;
                    }
                }
            }
            Tab {
                title: "CW";
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;
                    alignment: start;
                    inherit-box := CheckBox {
                        text: @tr("Use the project CW");
                        checked: root.form.inherit-cw;
                        toggled => { root.inherit-cw = self.checked; }
                    }
                    if !root.inherit-cw : VerticalLayout {
                        spacing: 10px;
                        CheckBox {
                            text: @tr("CW before VIS");
                            checked: root.form.cw-preamble;
                            toggled => { root.cw-pre-value = self.checked; }
                        }
                        CheckBox {
                            text: @tr("CW at the end");
                            checked: root.form.cw;
                            toggled => { root.cw-value = self.checked; }
                        }
                        Field {
                            label: @tr("Text (empty = project text)");
                            pcw := LineEdit { text: root.form.cw-text; edited(t) => { root.cw-text-value = t; } }
                        }
                    }
                }
            }
            Tab {
                title: @tr("Activations");
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        PanelTitle { text: @tr("TRIGGERS FOR THIS PROGRAM"); horizontal-stretch: 1; }
                        ToolButton {
                            icon: "plus";
                            text: @tr("Add");
                            clicked => { root.activation-add(); }
                        }
                    }
                    Hint {
                        text: @tr("When the code is heard, this program is transmitted (or the grid is paused / resumed). DTMF ends with #; CW, when the text ends with those words.");
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            for t[i] in root.activations : HorizontalLayout {
                                spacing: 8px;
                                height: 34px;
                                CheckBox {
                                    checked: t.enabled;
                                    toggled => { root.activation-edit(i, { enabled: self.checked, source: t.source, code: t.code, action: t.action, program: t.program }); }
                                }
                                ComboBox {
                                    width: 90px;
                                    model: ["DTMF", "CW"];
                                    current-index: t.source;
                                    selected => { root.activation-edit(i, { enabled: t.enabled, source: self.current-index, code: t.code, action: t.action, program: t.program }); }
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: t.code;
                                    placeholder-text: "*12#";
                                    edited(v) => { root.activation-edit(i, { enabled: t.enabled, source: t.source, code: v, action: t.action, program: t.program }); }
                                }
                                ComboBox {
                                    width: 140px;
                                    model: [@tr("Transmit"), @tr("Pause grid"), @tr("Resume grid")];
                                    current-index: t.action;
                                    selected => { root.activation-edit(i, { enabled: t.enabled, source: t.source, code: t.code, action: self.current-index, program: t.program }); }
                                }
                                ToolButton {
                                    icon: "trash";
                                    clicked => { root.activation-remove(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => {
                root.save({
                    name: name-edit.text,
                    enabled: enabled-box.checked,
                    rotation: rot-box.current-index,
                    inherit-cw: root.inherit-cw,
                    cw-preamble: root.cw-pre-value,
                    cw: root.cw-value,
                    cw-text: root.cw-text-value,
                    mode: mode-box.current-index,
                });
            }
        }
    }
    property <bool> cw-pre-value: root.form.cw-preamble;
    property <bool> cw-value: root.form.cw;
    property <string> cw-text-value: root.form.cw-text;
}
