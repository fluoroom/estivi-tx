import { ComboBox, CheckBox, LineEdit, SpinBox, Slider, TabWidget, ScrollView, Switch, Palette } from "std-widgets.slint";
import { Theme, ToolButton, Field, PanelTitle } from "theme.slint";
import { FileDrop, Files } from "files.slint";
import { TriggerItem, ImageItem } from "types.slint";

component DialogFooter inherits HorizontalLayout {
    in property <string> error;
    callback save();
    callback cancel();
    spacing: 8px;
    Text {
        text: root.error;
        color: Theme.danger;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    ToolButton {
        text: "Cancelar";
        clicked => { root.cancel(); }
    }
    ToolButton {
        text: "Guardar";
        primary: true;
        clicked => { root.save(); }
    }
}

component DayToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> on;
    width: 38px;
    height: 32px;
    border-radius: 5px;
    background: root.on ? Theme.accent : Theme.panel-raised;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 700;
        color: root.on ? #ffffff : Theme.text-dim;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.on = !root.on; }
    }
}

component Hint inherits Text {
    font-size: 11px;
    color: Theme.text-faint;
    wrap: word-wrap;
}

// ───────────────────────── Grid block ─────────────────────────

export struct SlotForm {
    name: string,
    enabled: bool,
    d0: bool,
    d1: bool,
    d2: bool,
    d3: bool,
    d4: bool,
    d5: bool,
    d6: bool,
    start: string,
    end: string,
    repeat: bool,
    every: int,
    program: int,
    freq: string,
}

export component SlotDialog inherits Window {
    title: "Bloque de la grilla";
    icon: @image-url("../assets/icon.png");
    width: 520px;
    height: 560px;
    background: Theme.bg;
   
    in property <SlotForm> form;
    in property <[string]> program-names;
    in property <string> tz-name: "UTC";
    in property <string> error;
    callback save(SlotForm);
    callback cancel();
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    property <bool> repeat: root.form.repeat;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        Field {
            label: "Nombre del bloque";
            name-edit := LineEdit {
                text: root.form.name;
                placeholder-text: "Ej.: Noche en 80 m";
            }
        }
        Field {
            label: "Días";
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                d0 := DayToggle { label: "L"; on: root.form.d0; }
                d1 := DayToggle { label: "M"; on: root.form.d1; }
                d2 := DayToggle { label: "X"; on: root.form.d2; }
                d3 := DayToggle { label: "J"; on: root.form.d3; }
                d4 := DayToggle { label: "V"; on: root.form.d4; }
                d5 := DayToggle { label: "S"; on: root.form.d5; }
                d6 := DayToggle { label: "D"; on: root.form.d6; }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Field {
                label: "Comienza (" + root.tz-name + ")";
                start-edit := LineEdit {
                    text: root.form.start;
                    placeholder-text: "HH:MM";
                }
            }
            Field {
                label: "Repetir";
                HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        repeat-switch := Switch {
                            checked: root.form.repeat;
                            toggled => { root.repeat = self.checked; }
                        }
                    }
                }
            }
        }
        if root.repeat : HorizontalLayout {
            spacing: 12px;
            Field {
                label: "Cada (minutos)";
                every-spin := SpinBox {
                    minimum: 1;
                    maximum: 1440;
                    value: root.form.every;
                    edited(v) => { root.every-value = v; }
                }
            }
            Field {
                label: "Hasta (" + root.tz-name + ")";
                end-edit := LineEdit {
                    text: root.form.end;
                    placeholder-text: "HH:MM";
                    edited(t) => { root.end-value = t; }
                }
            }
        }
        if root.repeat : Hint {
            text: "Si «hasta» es más temprano que el comienzo, el bloque termina al día siguiente. Si una emisión dura más que el intervalo, la siguiente sale apenas termina la pausa mínima.";
        }
        Field {
            label: "Qué sale al aire";
            program-box := ComboBox {
                model: root.program-names;
                current-index: root.form.program;
            }
        }
        Field {
            label: "Frecuencia (MHz, opcional — se fija por CAT si está habilitado)";
            freq-edit := LineEdit {
                text: root.form.freq;
                placeholder-text: "Ej.: 14.230";
            }
        }
        HorizontalLayout {
            alignment: start;
            enabled-box := CheckBox {
                text: "Bloque habilitado";
                checked: root.form.enabled;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => {
                root.save({
                    name: name-edit.text,
                    enabled: enabled-box.checked,
                    d0: d0.on, d1: d1.on, d2: d2.on, d3: d3.on, d4: d4.on, d5: d5.on, d6: d6.on,
                    start: start-edit.text,
                    end: root.end-value,
                    repeat: root.repeat,
                    every: root.every-value,
                    program: program-box.current-index,
                    freq: freq-edit.text,
                });
            }
        }
    }
    // The repeat fields live inside an `if`, so their values are mirrored here.
    property <int> every-value: root.form.every;
    property <string> end-value: root.form.end;
}

// ───────────────────────── Project ─────────────────────────

export struct ProjectForm {
    name: string,
    call: string,
    operator: string,
    qth: string,
    locator: string,
    color-range: int,
    vox: bool,
    fsk: bool,
    cw-preamble: bool,
    cw: bool,
    cw-text: string,
    cw-wpm: int,
    cw-tone: int,
    pause: int,
    offset-min: int,
    offset-sec: int,
    listen-cw: bool,
    listen-wpm: int,
    listen-tone: int,
    listen-dtmf: bool,
}

export component ProjectDialog inherits Window {
    title: "Proyecto";
    icon: @image-url("../assets/icon.png");
    width: 640px;
    height: 640px;
    background: Theme.bg;
   
    in property <ProjectForm> form;
    in property <[TriggerItem]> triggers;
    in property <[string]> program-names;
    in property <string> error;
    callback save(ProjectForm);
    callback cancel();
    callback trigger-add();
    callback trigger-remove(int);
    callback trigger-edit(int, TriggerItem);
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "Estación";
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: "Nombre del canal / proyecto";
                        name-edit := LineEdit { text: root.form.name; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "Indicativo";
                            call-edit := LineEdit { text: root.form.call; placeholder-text: "LU1ABC"; }
                        }
                        Field {
                            label: "Operador";
                            op-edit := LineEdit { text: root.form.operator; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "QTH";
                            qth-edit := LineEdit { text: root.form.qth; }
                        }
                        Field {
                            label: "Locator";
                            loc-edit := LineEdit { text: root.form.locator; placeholder-text: "FF78"; }
                        }
                    }
                    Hint {
                        text: "Estos datos se pueden mostrar en la gráfica con {call}, {op}, {qth} y {loc}. El modo SSTV se elige en la barra principal y también se guarda con el proyecto.";
                    }
                }
            }
            Tab {
                title: "Transmisión";
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: "Pausa mínima entre emisiones (segundos) — protege el equipo";
                        pause-spin := SpinBox { minimum: 0; maximum: 3600; value: root.form.pause; }
                    }
                    Field {
                        label: "Retraso de la grilla — todas las TX salen esta cantidad después de la hora del bloque";
                        HorizontalLayout {
                            spacing: 8px;
                            offset-min-spin := SpinBox { minimum: 0; maximum: 180; value: root.form.offset-min; }
                            Text { text: "min"; vertical-alignment: center; color: Theme.text-dim; }
                            offset-sec-spin := SpinBox { minimum: 0; maximum: 59; value: root.form.offset-sec; }
                            Text { text: "s"; vertical-alignment: center; color: Theme.text-dim; }
                        }
                    }
                    Hint {
                        text: "Los bloques se escriben en hora redonda (14:00). El retraso sirve para compartir frecuencia: si otro canal ocupa 14:00–14:03, poné 3 min y las tuyas empiezan a las 14:03.";
                    }
                    Field {
                        label: "Escala de color Robot / PD";
                        range-box := ComboBox {
                            model: ["Completa 0–255 (QSSTV, slowrx; recomendada)", "Estudio BT.601 16–235"];
                            current-index: root.form.color-range;
                        }
                    }
                    vox-box := CheckBox {
                        text: "Tonos de preámbulo antes del VIS (abren el VOX)";
                        checked: root.form.vox;
                    }
                    fsk-box := CheckBox {
                        text: "FSK ID al final (indicativo legible por MMSSTV)";
                        checked: root.form.fsk;
                    }
                    cw-pre-box := CheckBox {
                        text: "Identificación en CW antes del VIS (preámbulo)";
                        checked: root.form.cw-preamble;
                    }
                    cw-box := CheckBox {
                        text: "Identificación en CW al final de cada emisión";
                        checked: root.form.cw;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "Texto CW";
                            horizontal-stretch: 2;
                            cw-text-edit := LineEdit { text: root.form.cw-text; }
                        }
                        Field {
                            label: "Velocidad (ppm)";
                            cw-wpm-spin := SpinBox { minimum: 5; maximum: 50; value: root.form.cw-wpm; }
                        }
                        Field {
                            label: "Tono (Hz)";
                            cw-tone-spin := SpinBox { minimum: 300; maximum: 2500; step-size: 50; value: root.form.cw-tone; }
                        }
                    }
                    Hint {
                        text: "El preámbulo va después de los tonos VOX y antes del VIS. El post, después de la imagen (y del FSK ID si está). El texto admite {call}. El reglamento (ENACOM) marca cada cuánto hay que identificarse.";
                    }
                }
            }
            Tab {
                title: "Escucha y disparadores";
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            listen-cw-box := CheckBox { text: "Decodificar CW"; checked: root.form.listen-cw; }
                        }
                        Field {
                            label: "Velocidad fija (ppm)";
                            listen-wpm-spin := SpinBox { minimum: 5; maximum: 50; value: root.form.listen-wpm; }
                        }
                        Field {
                            label: "Tono (Hz)";
                            listen-tone-spin := SpinBox { minimum: 300; maximum: 2500; step-size: 10; value: root.form.listen-tone; }
                        }
                    }
                    listen-dtmf-box := CheckBox { text: "Decodificar DTMF"; checked: root.form.listen-dtmf; }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        PanelTitle { text: "DISPARADORES"; horizontal-stretch: 1; }
                        ToolButton {
                            icon: "plus";
                            text: "Agregar";
                            clicked => { root.trigger-add(); }
                        }
                    }
                    Hint {
                        text: "DTMF: la secuencia termina con # o tras 2,5 s de silencio (ej.: *12#). CW: se dispara cuando el texto recibido termina con esas palabras (ej.: QRV SSTV).";
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            for t[i] in root.triggers : HorizontalLayout {
                                spacing: 8px;
                                height: 34px;
                                VerticalLayout {
                                    alignment: center;
                                    CheckBox {
                                        checked: t.enabled;
                                        toggled => { root.trigger-edit(i, { enabled: self.checked, source: t.source, code: t.code, action: t.action, program: t.program }); }
                                    }
                                }
                                ComboBox {
                                    width: 90px;
                                    model: ["DTMF", "CW"];
                                    current-index: t.source;
                                    selected => { root.trigger-edit(i, { enabled: t.enabled, source: self.current-index, code: t.code, action: t.action, program: t.program }); }
                                }
                                LineEdit {
                                    width: 120px;
                                    text: t.code;
                                    placeholder-text: "*12#";
                                    edited(v) => { root.trigger-edit(i, { enabled: t.enabled, source: t.source, code: v, action: t.action, program: t.program }); }
                                }
                                ComboBox {
                                    width: 130px;
                                    model: ["Transmitir", "Pausar grilla", "Reanudar grilla"];
                                    current-index: t.action;
                                    selected => { root.trigger-edit(i, { enabled: t.enabled, source: t.source, code: t.code, action: self.current-index, program: t.program }); }
                                }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    enabled: t.action == 0;
                                    model: root.program-names;
                                    current-index: t.program;
                                    selected => { root.trigger-edit(i, { enabled: t.enabled, source: t.source, code: t.code, action: t.action, program: self.current-index }); }
                                }
                                ToolButton {
                                    icon: "trash";
                                    clicked => { root.trigger-remove(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => {
                root.save({
                    name: name-edit.text,
                    call: call-edit.text,
                    operator: op-edit.text,
                    qth: qth-edit.text,
                    locator: loc-edit.text,
                    color-range: range-box.current-index,
                    vox: vox-box.checked,
                    fsk: fsk-box.checked,
                    cw-preamble: cw-pre-box.checked,
                    cw: cw-box.checked,
                    cw-text: cw-text-edit.text,
                    cw-wpm: cw-wpm-spin.value,
                    cw-tone: cw-tone-spin.value,
                    pause: pause-spin.value,
                    offset-min: offset-min-spin.value,
                    offset-sec: offset-sec-spin.value,
                    listen-cw: listen-cw-box.checked,
                    listen-wpm: listen-wpm-spin.value,
                    listen-tone: listen-tone-spin.value,
                    listen-dtmf: listen-dtmf-box.checked,
                });
            }
        }
    }
}

// ───────────────────────── Station hardware ─────────────────────────

export struct ConfigForm {
    out-index: int,
    in-index: int,
    rate-index: int,
    channel: int,
    level: float,
    ppm: string,
    ptt-method: int,
    port-index: int,
    port-manual: string,
    line: int,
    invert: bool,
    lead: int,
    tail: int,
    timeout: int,
    cat-host: string,
    cat-port: int,
    cat-freq: bool,
    autostart: bool,
    gpu: bool,
    light: bool,
}

export component ConfigDialog inherits Window {
    title: "Equipo: audio, PTT y CAT";
    icon: @image-url("../assets/icon.png");
    width: 640px;
    height: 660px;
    background: Theme.bg;
   
    in property <ConfigForm> form;
    in property <[string]> out-devices;
    in property <[string]> in-devices;
    in property <[string]> ports;
    in property <string> config-path;
    in property <string> error;
    in property <string> test-state;
    callback save(ConfigForm);
    callback cancel();
    callback test-tone(ConfigForm);
    callback test-ptt(ConfigForm);
    callback refresh();
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    property <int> method: root.form.ptt-method;

    function current() -> ConfigForm {
        return {
            out-index: out-box.current-index,
            in-index: in-box.current-index,
            rate-index: rate-box.current-index,
            channel: channel-box.current-index,
            level: level-slider.value,
            ppm: ppm-edit.text,
            ptt-method: root.method,
            port-index: root.port-index,
            port-manual: root.port-manual,
            line: root.line,
            invert: root.invert,
            lead: lead-spin.value,
            tail: tail-spin.value,
            timeout: timeout-spin.value,
            cat-host: root.cat-host,
            cat-port: root.cat-port,
            cat-freq: root.cat-freq,
            autostart: autostart-box.checked,
            gpu: gpu-box.checked,
            light: light-box.checked,
        };
    }

    // Fields shown conditionally are mirrored in properties so they survive toggling.
    property <int> port-index: root.form.port-index;
    property <string> port-manual: root.form.port-manual;
    property <int> line: root.form.line;
    property <bool> invert: root.form.invert;
    property <string> cat-host: root.form.cat-host;
    property <int> cat-port: root.form.cat-port;
    property <bool> cat-freq: root.form.cat-freq;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "Audio";
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: "Salida (hacia el transmisor)";
                        out-box := ComboBox { model: root.out-devices; current-index: root.form.out-index; }
                    }
                    Field {
                        label: "Entrada (desde el receptor, para CW / DTMF)";
                        in-box := ComboBox { model: root.in-devices; current-index: root.form.in-index; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "Frecuencia de muestreo";
                            rate-box := ComboBox {
                                model: ["La del dispositivo", "8000 Hz", "11025 Hz", "22050 Hz", "44100 Hz", "48000 Hz"];
                                current-index: root.form.rate-index;
                            }
                        }
                        Field {
                            label: "Canal de salida";
                            channel-box := ComboBox {
                                model: ["Ambos", "Izquierdo", "Derecho"];
                                current-index: root.form.channel;
                            }
                        }
                    }
                    Field {
                        label: "Nivel de salida: " + round(level-slider.value) + " %";
                        level-slider := Slider { minimum: 0; maximum: 100; value: root.form.level; }
                    }
                    Field {
                        label: "Corrección del reloj de la placa (ppm) — si las imágenes salen inclinadas";
                        ppm-edit := LineEdit { text: root.form.ppm; placeholder-text: "0"; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        ToolButton {
                            icon: "wave";
                            text: "Tono de prueba 5 s (con PTT)";
                            clicked => { root.test-tone(root.current()); }
                        }
                        ToolButton {
                            text: "Volver a buscar dispositivos";
                            clicked => { root.refresh(); }
                        }
                    }
                    Hint {
                        text: "Con el tono de prueba ajustá el nivel hasta que el ALC del equipo apenas se mueva.";
                    }
                }
            }
            Tab {
                title: "PTT y CAT";
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    Field {
                        label: "Cómo se pone en transmisión el equipo";
                        method-box := ComboBox {
                            model: ["Ninguno (solo audio)", "VOX del equipo", "Puerto serie (RTS / DTR)", "CAT por Hamlib (rigctld)"];
                            current-index: root.method;
                            selected => { root.method = self.current-index; }
                        }
                    }
                    if root.method == 2 : VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: "Puerto detectado";
                                ComboBox {
                                    model: root.ports;
                                    current-index: root.port-index;
                                    selected => { root.port-index = self.current-index; }
                                }
                            }
                            Field {
                                label: "u otro (ej.: COM7, /dev/ttyACM0)";
                                LineEdit {
                                    text: root.port-manual;
                                    edited(t) => { root.port-manual = t; }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: "Línea";
                                ComboBox {
                                    model: ["RTS", "DTR", "RTS y DTR"];
                                    current-index: root.line;
                                    selected => { root.line = self.current-index; }
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                CheckBox {
                                    text: "Invertida (activa en bajo)";
                                    checked: root.invert;
                                    toggled => { root.invert = self.checked; }
                                }
                            }
                        }
                    }
                    if root.method == 3 : VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: "Host de rigctld";
                                horizontal-stretch: 2;
                                LineEdit {
                                    text: root.cat-host;
                                    edited(t) => { root.cat-host = t; }
                                }
                            }
                            Field {
                                label: "Puerto";
                                SpinBox {
                                    minimum: 1;
                                    maximum: 65535;
                                    value: root.cat-port;
                                    edited(v) => { root.cat-port = v; }
                                }
                            }
                        }
                        CheckBox {
                            text: "Fijar la frecuencia de cada bloque antes de transmitir";
                            checked: root.cat-freq;
                            toggled => { root.cat-freq = self.checked; }
                        }
                        Hint {
                            text: "Ejemplo: rigctld -m <modelo> -r /dev/ttyUSB0 -s 38400. Hamlib soporta cientos de equipos.";
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "Retardo antes del audio (ms)";
                            lead-spin := SpinBox { minimum: 0; maximum: 5000; step-size: 50; value: root.form.lead; }
                        }
                        Field {
                            label: "Cola después (ms)";
                            tail-spin := SpinBox { minimum: 0; maximum: 5000; step-size: 50; value: root.form.tail; }
                        }
                        Field {
                            label: "Tiempo máximo (s)";
                            timeout-spin := SpinBox { minimum: 30; maximum: 3600; step-size: 30; value: root.form.timeout; }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        ToolButton {
                            text: "Probar PTT (2 s)";
                            clicked => { root.test-ptt(root.current()); }
                        }
                    }
                }
            }
            Tab {
                title: "General";
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;
                    autostart-box := CheckBox {
                        text: "Arrancar con la grilla al aire (estaciones desatendidas)";
                        checked: root.form.autostart;
                    }
                    gpu-box := CheckBox {
                        text: "Dibujar la interfaz con la GPU (OpenGL; usa más memoria, requiere reiniciar)";
                        checked: root.form.gpu;
                    }
                    light-box := CheckBox {
                        text: "Tema claro";
                        checked: root.form.light;
                    }
                    Hint {
                        text: "Esta configuración es de esta PC (audio, puerto, PTT) y se guarda aparte del proyecto, en:\n" + root.config-path;
                    }
                }
            }
        }
        if root.test-state != "" : Text {
            text: root.test-state;
            font-size: 12px;
            color: Theme.text-dim;
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => { root.save(root.current()); }
        }
    }
}

// ───────────────────────── Confirmation / message ─────────────────────────

export component ConfirmDialog inherits Window {
    title: "Estivi";
    icon: @image-url("../assets/icon.png");
    preferred-width: 460px;
    background: Theme.bg;
   
    in property <string> heading;
    in property <string> message;
    in property <string> primary: "Aceptar";
    // Empty = button hidden.
    in property <string> secondary;
    in property <string> cancel;
    // 0 primary, 1 secondary, 2 cancel
    callback chosen(int);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Text {
            text: root.heading;
            font-size: 16px;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.message;
            font-size: 13px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            padding-top: 6px;
            if root.cancel != "" : ToolButton {
                text: root.cancel;
                clicked => { root.chosen(2); }
            }
            if root.secondary != "" : ToolButton {
                text: root.secondary;
                clicked => { root.chosen(1); }
            }
            ToolButton {
                text: root.primary;
                primary: true;
                clicked => { root.chosen(0); }
            }
        }
    }
}

// ───────────────────────── Rename ─────────────────────────

export component RenameDialog inherits Window {
    title: "Renombrar";
    icon: @image-url("../assets/icon.png");
    preferred-width: 420px;
    background: Theme.bg;
   
    in property <string> heading;
    in property <string> value;
    callback save(string);
    callback cancel();
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Field {
            label: root.heading;
            name-edit := LineEdit {
                text: root.value;
                accepted(t) => { root.save(t); }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            ToolButton {
                text: "Cancelar";
                clicked => { root.cancel(); }
            }
            ToolButton {
                text: "Guardar";
                primary: true;
                clicked => { root.save(name-edit.text); }
            }
        }
    }
    init => { name-edit.focus(); }
}

// ───────────────────────── Program (image group) ─────────────────────────

export struct ProgramForm {
    name: string,
    enabled: bool,
    rotation: int,
    inherit-cw: bool,
    cw-preamble: bool,
    cw: bool,
    cw-text: string,
    mode: int,
}

export component ProgramDialog inherits Window {
    title: "Programa";
    icon: @image-url("../assets/icon.png");
    width: 760px;
    height: 720px;
    background: Theme.bg;
   
    in property <ProgramForm> form;
    in property <[ImageItem]> images;
    in property <[TriggerItem]> activations;
    in property <[string]> mode-names;
    in property <[string]> image-modes;
    in property <string> error;
    callback save(ProgramForm);
    callback cancel();
    callback images-dropped([string]);
    callback pick-images();
    callback image-remove(int);
    callback image-move(int, int);
    callback image-toggle(int, bool);
    callback image-mode(int, int);
    callback activation-add();
    callback activation-remove(int);
    callback activation-edit(int, TriggerItem);
    init => { Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark; }

    property <bool> inherit-cw: root.form.inherit-cw;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "Imágenes";
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Field {
                        label: "Nombre del programa";
                        name-edit := LineEdit {
                            text: root.form.name;
                            placeholder-text: "Ej.: Noche en 80 m";
                        }
                    }
                    Field {
                        label: "Orden de las imágenes";
                        rot-box := ComboBox {
                            model: ["En orden", "Aleatorio (sin repetir)"];
                            current-index: root.form.rotation;
                        }
                    }
                    Field {
                        label: "Modo SSTV del programa (default de sus imágenes)";
                        mode-box := ComboBox {
                            model: root.mode-names;
                            current-index: root.form.mode;
                        }
                    }
                    FileDrop {
                        compact: true;
                        title: "Soltá o elegí imágenes";
                        hint: "PNG, JPG, BMP o GIF. Varias a la vez.";
                        many: true;
                        dropped(paths) => { root.images-dropped(paths); }
                        browse => { root.pick-images(); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            for img[i] in root.images : HorizontalLayout {
                                spacing: 8px;
                                height: 48px;
                                Rectangle {
                                    width: 56px;
                                    background: #111111;
                                    Image {
                                        source: img.thumb;
                                        image-fit: contain;
                                        opacity: img.enabled ? 1.0 : 0.35;
                                    }
                                    if img.missing : Text {
                                        text: "FALTA";
                                        font-size: 9px;
                                        color: #ffffff;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: img.name;
                                        font-size: 13px;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: img.path;
                                        font-size: 11px;
                                        color: Theme.text-faint;
                                        overflow: elide;
                                    }
                                }
                                ComboBox {
                                    width: 150px;
                                    model: root.image-modes;
                                    current-index: img.mode-index;
                                    selected => { root.image-mode(i, self.current-index); }
                                }
                                CheckBox {
                                    checked: img.enabled;
                                    toggled => { root.image-toggle(i, self.checked); }
                                }
                                ToolButton {
                                    icon: "up";
                                    enabled: i > 0;
                                    clicked => { root.image-move(i, -1); }
                                }
                                ToolButton {
                                    icon: "down";
                                    enabled: i < root.images.length - 1;
                                    clicked => { root.image-move(i, 1); }
                                }
                                ToolButton {
                                    icon: "trash";
                                    clicked => { root.image-remove(i); }
                                }
                            }
                        }
                    }
                    if root.images.length == 0 : Text {
                        text: "Un programa es un grupo de imágenes. Arrastrá varias o elegilas con el botón.";
                        font-size: 12px;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    enabled-box := CheckBox {
                        text: "Programa habilitado";
                        checked: root.form.enabled;
                    }
                }
            }
            Tab {
                title: "CW";
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;
                    alignment: start;
                    inherit-box := CheckBox {
                        text: "Usar el CW del proyecto";
                        checked: root.form.inherit-cw;
                        toggled => { root.inherit-cw = self.checked; }
                    }
                    if !root.inherit-cw : VerticalLayout {
                        spacing: 10px;
                        CheckBox {
                            text: "CW antes del VIS";
                            checked: root.form.cw-preamble;
                            toggled => { root.cw-pre-value = self.checked; }
                        }
                        CheckBox {
                            text: "CW al final";
                            checked: root.form.cw;
                            toggled => { root.cw-value = self.checked; }
                        }
                        Field {
                            label: "Texto (vacío = el del proyecto)";
                            pcw := LineEdit { text: root.form.cw-text; edited(t) => { root.cw-text-value = t; } }
                        }
                    }
                }
            }
            Tab {
                title: "Activaciones";
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        PanelTitle { text: "DISPARADORES DE ESTE PROGRAMA"; horizontal-stretch: 1; }
                        ToolButton {
                            icon: "plus";
                            text: "Agregar";
                            clicked => { root.activation-add(); }
                        }
                    }
                    Hint {
                        text: "Si se oye el código, se transmite este programa (o se pausa / reanuda la grilla). DTMF termina en #; CW, cuando el texto acaba en esas palabras.";
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            for t[i] in root.activations : HorizontalLayout {
                                spacing: 8px;
                                height: 34px;
                                CheckBox {
                                    checked: t.enabled;
                                    toggled => { root.activation-edit(i, { enabled: self.checked, source: t.source, code: t.code, action: t.action, program: t.program }); }
                                }
                                ComboBox {
                                    width: 90px;
                                    model: ["DTMF", "CW"];
                                    current-index: t.source;
                                    selected => { root.activation-edit(i, { enabled: t.enabled, source: self.current-index, code: t.code, action: t.action, program: t.program }); }
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: t.code;
                                    placeholder-text: "*12#";
                                    edited(v) => { root.activation-edit(i, { enabled: t.enabled, source: t.source, code: v, action: t.action, program: t.program }); }
                                }
                                ComboBox {
                                    width: 140px;
                                    model: ["Transmitir", "Pausar grilla", "Reanudar grilla"];
                                    current-index: t.action;
                                    selected => { root.activation-edit(i, { enabled: t.enabled, source: t.source, code: t.code, action: self.current-index, program: t.program }); }
                                }
                                ToolButton {
                                    icon: "trash";
                                    clicked => { root.activation-remove(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
        DialogFooter {
            error: root.error;
            cancel => { root.cancel(); }
            save => {
                root.save({
                    name: name-edit.text,
                    enabled: enabled-box.checked,
                    rotation: rot-box.current-index,
                    inherit-cw: root.inherit-cw,
                    cw-preamble: root.cw-pre-value,
                    cw: root.cw-value,
                    cw-text: root.cw-text-value,
                    mode: mode-box.current-index,
                });
            }
        }
    }
    property <bool> cw-pre-value: root.form.cw-preamble;
    property <bool> cw-value: root.form.cw;
    property <string> cw-text-value: root.form.cw-text;
}
