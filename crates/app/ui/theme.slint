// Flat utility chrome with a little more depth. `light` is set from Equipo →
// General and follows every window. Colors still come from Rust (app.rs), so
// every derived tone below follows the selected theme.

import { ComboBox, Palette } from "std-widgets.slint";
import "../../core/assets/fonts/NotoSansMono-Bold.ttf";

export global Theme {
    in-out property <bool> light: false;
    in-out property <color> bg: #141414;
    in-out property <color> panel: #1c1c1c;
    in-out property <color> panel-raised: #262626;
    in-out property <color> field: #141414;
    in-out property <color> border: #333333;
    in-out property <color> border-strong: #4a4a4a;
    in-out property <color> text: #ececec;
    in-out property <color> text-dim: #9a9a9a;
    in-out property <color> text-faint: #6e6e6e;
    in-out property <color> accent: #d4d4d4;
    in-out property <color> on-accent: #141414;
    in-out property <color> on-air: #dc2626;
    in-out property <color> ready: #16a34a;
    in-out property <color> paused: #d97706;
    in-out property <color> danger: #dc2626;
    // Timeline piece colors. Each theme keeps its own so the labels read on both grounds.
    in-out property <color> tx-cw: #38bdf8;
    in-out property <color> tx-ax: #fbbf24;
    in-out property <color> tx-welcome: #4ade80;
    in-out property <color> tx-bumper: #c084fc;
    out property <length> radius: 6px;
    out property <length> radius-sm: 4px;
    out property <length> radius-lg: 10px;
    out property <length> gap: 8px;
    out property <string> mono: "Noto Sans Mono";
    // Derived tones. They follow whichever palette Rust installed.
    out property <color> accent-soft: accent.transparentize(0.86);
    out property <color> accent-hover: accent.transparentize(0.92);
    out property <color> shadow: light ? #00000030 : #00000070;
    out property <color> button-hover: light ? panel-raised.darker(0.035) : panel-raised.brighter(0.07);
    out property <color> button-pressed: light ? panel-raised.darker(0.075) : panel-raised.darker(0.14);
}

export component PanelTitle inherits Text {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.7px;
    color: Theme.text-faint;
    vertical-alignment: center;
}

export component Panel inherits Rectangle {
    in property <string> title;
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
}

export component Icon inherits Path {
    in property <string> name;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    fill: Theme.text;
    stroke-width: 0px;
    commands: name == "play" ? "M 4 2 L 14 8 L 4 14 Z"
        : name == "stop" ? "M 3 3 L 13 3 L 13 13 L 3 13 Z"
        : name == "pause" ? "M 3 2 L 7 2 L 7 14 L 3 14 Z M 9 2 L 13 2 L 13 14 L 9 14 Z"
        : name == "plus" ? "M 7 2 L 9 2 L 9 7 L 14 7 L 14 9 L 9 9 L 9 14 L 7 14 L 7 9 L 2 9 L 2 7 L 7 7 Z"
        : name == "minus" ? "M 2 7 L 14 7 L 14 9 L 2 9 Z"
        : name == "up" ? "M 8 3 L 14 11 L 2 11 Z"
        : name == "down" ? "M 2 5 L 14 5 L 8 13 Z"
        : name == "text" ? "M 2 2 L 14 2 L 14 5 L 12.5 5 L 12.5 3.5 L 9 3.5 L 9 12.5 L 10.5 12.5 L 10.5 14 L 5.5 14 L 5.5 12.5 L 7 12.5 L 7 3.5 L 3.5 3.5 L 3.5 5 L 2 5 Z"
        : name == "image" ? "M 1 2 L 15 2 L 15 14 L 1 14 Z M 2.5 12.5 L 13.5 12.5 L 13.5 10 L 10.5 6.5 L 7 10.5 L 5.5 9 L 2.5 12 Z M 4.5 4 A 1.5 1.5 0 1 0 4.5 7 A 1.5 1.5 0 1 0 4.5 4 Z"
        : name == "eye" ? "M 8 3 C 4 3 1.5 6 0.5 8 C 1.5 10 4 13 8 13 C 12 13 14.5 10 15.5 8 C 14.5 6 12 3 8 3 Z M 8 5.5 A 2.5 2.5 0 1 1 8 10.5 A 2.5 2.5 0 1 1 8 5.5 Z"
        : name == "eye-off" ? "M 2 1 L 15 14 L 14 15 L 1 2 Z M 8 3 C 6.8 3 5.8 3.3 4.9 3.8 L 6.3 5.2 C 6.8 4.9 7.4 4.8 8 4.8 C 9.8 4.8 11.2 6.2 11.2 8 C 11.2 8.6 11.1 9.2 10.8 9.7 L 12.6 11.5 C 14 10.4 15 9 15.5 8 C 14.5 6 12 3 8 3 Z M 3.4 4.5 C 2 5.6 1 7 0.5 8 C 1.5 10 4 13 8 13 C 9.2 13 10.2 12.7 11.1 12.2 L 9.7 10.8 C 9.2 11.1 8.6 11.2 8 11.2 C 6.2 11.2 4.8 9.8 4.8 8 C 4.8 7.4 4.9 6.8 5.2 6.3 Z"
        : name == "trash" ? "M 5 1 L 11 1 L 11 3 L 14 3 L 14 4.5 L 2 4.5 L 2 3 L 5 3 Z M 3 5.5 L 13 5.5 L 12 15 L 4 15 Z"
        : name == "copy" ? "M 5 1 L 15 1 L 15 11 L 11 11 L 11 9.5 L 13.5 9.5 L 13.5 2.5 L 6.5 2.5 L 6.5 5 L 5 5 Z M 1 5 L 11 5 L 11 15 L 1 15 Z"
        : name == "edit" ? "M 11 1 L 15 5 L 6 14 L 1 15 L 2 10 Z"
        : name == "gear" ? "M 7 0.5 L 9 0.5 L 9.4 2.6 L 11 3.3 L 12.8 2.1 L 14.2 3.5 L 13 5.3 L 13.6 6.8 L 15.5 7 L 15.5 9 L 13.6 9.3 L 13 10.8 L 14.1 12.6 L 12.7 14 L 11 12.8 L 9.4 13.5 L 9 15.5 L 7 15.5 L 6.6 13.5 L 5 12.8 L 3.3 14 L 1.9 12.6 L 3 10.8 L 2.4 9.3 L 0.5 9 L 0.5 7 L 2.4 6.7 L 3 5.2 L 1.8 3.5 L 3.2 2.1 L 5 3.3 L 6.6 2.6 Z M 8 5.3 A 2.7 2.7 0 1 0 8 10.7 A 2.7 2.7 0 1 0 8 5.3 Z"
        : name == "folder" ? "M 1 3 L 6 3 L 7.5 4.5 L 15 4.5 L 15 14 L 1 14 Z"
        : name == "save" ? "M 1 1 L 12 1 L 15 4 L 15 15 L 1 15 Z M 4 2.5 L 4 6 L 11 6 L 11 2.5 Z M 4 9 L 4 13.5 L 12 13.5 L 12 9 Z"
        : name == "file" ? "M 2 1 L 10 1 L 14 5 L 14 15 L 2 15 Z M 9.5 2 L 9.5 5.5 L 13 5.5 Z"
        : name == "qr" ? "M 1 1 L 7 1 L 7 7 L 1 7 Z M 2.4 2.4 L 5.6 2.4 L 5.6 5.6 L 2.4 5.6 Z M 9 1 L 15 1 L 15 7 L 9 7 Z M 10.4 2.4 L 13.6 2.4 L 13.6 5.6 L 10.4 5.6 Z M 1 9 L 7 9 L 7 15 L 1 15 Z M 2.4 10.4 L 5.6 10.4 L 5.6 13.6 L 2.4 13.6 Z M 9 9 L 10.5 9 L 10.5 10.5 L 9 10.5 Z M 12 9 L 15 9 L 15 12 L 12 12 Z M 9 12 L 12 12 L 12 15 L 9 15 Z M 13.5 13.5 L 15 13.5 L 15 15 L 13.5 15 Z"
        : name == "layers" ? "M 8 1 L 15 5 L 8 9 L 1 5 Z M 2.6 8 L 8 11 L 13.4 8 L 15 9 L 8 13 L 1 9 Z"
        : name == "wave" ? "M 0 7.2 L 2 7.2 L 3.5 3 L 6 13 L 8.5 3 L 11 13 L 12.5 7.2 L 16 7.2 L 16 8.8 L 13.6 8.8 L 11 16 L 8.5 6 L 6 16 L 3.5 6 L 3 8.8 L 0 8.8 Z"
        : "";
}

export component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> active: false;
    // A button with no chrome until it is hovered, selected or pressed.
    in property <bool> flat: false;
    in property <string> tooltip;
    callback clicked();
    height: 28px;
    border-radius: Theme.radius;
    property <color> fg: !root.enabled ? Theme.text-faint
        : root.primary ? Theme.on-accent
        : root.danger ? #ffffff
        : Theme.text;
    background: !root.enabled ? (root.flat ? transparent : Theme.panel-raised.transparentize(0.55))
        : root.primary ? (ta.pressed ? Theme.accent.darker(0.12) : ta.has-hover ? Theme.accent.brighter(0.06) : Theme.accent)
        : root.danger ? (ta.pressed ? Theme.on-air.darker(0.14) : ta.has-hover ? Theme.on-air.brighter(0.06) : Theme.on-air)
        : root.active ? Theme.accent.transparentize(ta.pressed ? 0.78 : 0.86)
        : ta.pressed ? Theme.button-pressed
        : ta.has-hover ? (root.flat ? Theme.accent-hover : Theme.button-hover)
        : root.flat ? transparent : Theme.panel-raised;
    border-width: 1px;
    border-color: !root.enabled ? transparent
        : root.active ? Theme.accent.transparentize(0.35)
        : root.flat ? (ta.has-hover ? Theme.border : transparent)
        : (root.primary || root.danger) ? transparent
        : ta.has-hover ? Theme.border-strong : Theme.border;
    animate background, border-color { duration: 110ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: root.text == "" ? 6px : 9px;
        padding-right: root.text == "" ? 6px : 11px;
        spacing: 6px;
        alignment: center;
        if root.icon != "" : VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                fill: root.fg;
            }
        }
        if root.text != "" : Text {
            text: root.text;
            color: root.fg;
            font-size: 12px;
            font-weight: (root.primary || root.danger || root.active) ? 600 : 450;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A compact group of mutually exclusive buttons. Used for tabs and for the
// editor's alignment choices.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <bool> compact: false;
    callback chosen(int);
    height: root.compact ? 26px : 30px;
    border-radius: Theme.radius;
    background: Theme.light ? Theme.panel-raised.transparentize(0.35) : Theme.field;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options : Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            background: i == root.current ? Theme.accent.transparentize(0.84)
                : seg-ta.has-hover ? Theme.accent.transparentize(0.93) : transparent;
            animate background { duration: 110ms; easing: ease-out; }
            Text {
                text: o;
                font-size: 11px;
                font-weight: i == root.current ? 600 : 450;
                color: i == root.current ? Theme.text : Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen(i); }
            }
        }
    }
}

// A combo whose shown row follows `index` after the user has picked once.
// Choosing an item assigns ComboBox.current-index and drops the binding.
export component BoundCombo inherits VerticalLayout {
    in property <[string]> model;
    in property <int> index;
    callback selected(int);
    box := ComboBox {
        model: root.model;
        current-index: root.index;
        selected => { root.selected(self.current-index); }
    }
    changed index => { box.current-index = root.index; }
}

export component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: 11px;
        font-weight: 500;
        color: Theme.text-dim;
    }
    @children
}

// A one-line field for the settings strip in the upper card: the label sits to the
// left so a whole form fits in the height of the status card.
export component MiniField inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 78px;
    spacing: 6px;
    height: 26px;
    Text {
        width: root.label-width;
        text: root.label;
        font-size: 10px;
        font-weight: 500;
        color: Theme.text-dim;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

export component ColorField inherits HorizontalLayout {
    in property <color> value;
    in property <string> hex;
    callback changed(string);
    spacing: 6px;
    height: 28px;
    swatch := Rectangle {
        width: 28px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: swatch-ta.has-hover ? Theme.accent : Theme.border-strong;
        clip: true;
        Rectangle {
            x: 0; y: 0; width: 50%; height: 50%;
            background: #88888830;
        }
        Rectangle {
            x: parent.width / 2; y: parent.height / 2; width: 50%; height: 50%;
            background: #88888830;
        }
        Rectangle {
            border-radius: Theme.radius-sm;
            background: root.value;
        }
        swatch-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { palette.show(); }
        }
    }
    hex-edit := Rectangle {
        background: Theme.field;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        animate border-color { duration: 110ms; }
        input := TextInput {
            x: 8px;
            width: parent.width - 16px;
            text: root.hex;
            color: Theme.text;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
            single-line: true;
            accepted => { root.changed(self.text); }
            edited => {
                if (self.text.character-count == 7 || self.text.character-count == 9) {
                    root.changed(self.text);
                }
            }
        }
    }
    palette := PopupWindow {
        x: 0;
        y: 32px;
        width: 8 * 26px + 12px;
        height: 3 * 26px + 12px;
        Rectangle {
            background: Theme.panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow;
        }
        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            for row in [
                [{ c: #ffffff, h: "#FFFFFF" }, { c: #d0d5dd, h: "#D0D5DD" }, { c: #8a93a3, h: "#8A93A3" }, { c: #3d4450, h: "#3D4450" },
                 { c: #000000, h: "#000000" }, { c: #00000080, h: "#00000080" }, { c: #ffffff80, h: "#FFFFFF80" }, { c: #00000000, h: "#00000000" }],
                [{ c: #ef4444, h: "#EF4444" }, { c: #f97316, h: "#F97316" }, { c: #f59e0b, h: "#F59E0B" }, { c: #facc15, h: "#FACC15" },
                 { c: #84cc16, h: "#84CC16" }, { c: #22c55e, h: "#22C55E" }, { c: #14b8a6, h: "#14B8A6" }, { c: #06b6d4, h: "#06B6D4" }],
                [{ c: #0ea5e9, h: "#0EA5E9" }, { c: #3b82f6, h: "#3B82F6" }, { c: #6366f1, h: "#6366F1" }, { c: #8b5cf6, h: "#8B5CF6" },
                 { c: #a855f7, h: "#A855F7" }, { c: #d946ef, h: "#D946EF" }, { c: #ec4899, h: "#EC4899" }, { c: #7f1d1d, h: "#7F1D1D" }],
            ] : HorizontalLayout {
                spacing: 2px;
                for sw in row : Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    background: sw.c;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.changed(sw.h); }
                    }
                }
            }
        }
    }
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.ready;
    in property <bool> filled: false;
    in property <bool> dot: false;
    height: 20px;
    border-radius: 10px;
    background: root.filled ? root.tone : root.tone.transparentize(0.86);
    border-width: 1px;
    border-color: root.filled ? root.tone : root.tone.transparentize(0.55);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        if root.dot : Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 3px;
            background: root.filled ? #ffffff : root.tone;
        }
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: root.filled ? #ffffff : root.tone;
            vertical-alignment: center;
        }
    }
}
